<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <!-- O SDK inclui **/*.cs por padrão, o que arrastaria o projeto de testes (subpasta)
       pra dentro da compilação do site — exclui explicitamente. -->
  <ItemGroup>
    <Compile Remove="ListasCompras.Tests/**/*.cs" />
    <Content Remove="ListasCompras.Tests/**/*" />
    <None Remove="ListasCompras.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- Deixa o executável rodar como Serviço do Windows (install.bat usa sc.exe pra
         registrar); no Linux/systemd este pacote não faz nada, então não custa nada aqui -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!-- VERSION.txt mora na raiz do repositório (ao lado de install.sh/install.bat), mas
       precisa ir junto no publish para o aviso de atualização saber a versão instalada -->
  <ItemGroup>
    <Content Include="..\VERSION.txt" Link="VERSION.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>