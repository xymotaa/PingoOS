@model List<ListasCompras.Models.OrdemServico>
@{
    Layout = null;
    ViewData["Title"] = "Garantias";
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var retornos = ViewData["Retornos"] as Dictionary<int, int> ?? new();

    (string fundo, string texto) Cor(ListasCompras.Models.OrdemServico o) =>
        o.GarantiaVigente ? ("bg-secondary-container", "text-on-secondary-container")
                          : ("bg-surface-container-high", "text-on-surface-variant");
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — Garantias</title>
    @await Html.PartialAsync("_HeadTailwind")
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>@TempData["Sucesso"]</span>
            </div>
        }

        <!-- Cabeçalho da página -->
        <section class="mb-md">
            <h1 class="font-headline-lg text-headline-lg text-primary">Garantias</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Ordens já entregues. A garantia conta a partir da retirada — é aqui que se confere
                quando o cliente volta dizendo que está na garantia.
            </p>
        </section>

        <!-- Resumo -->
        <section class="grid grid-cols-2 md:grid-cols-3 gap-sm mb-md">
            <div class="bg-white px-md py-sm rounded-lg border border-outline-variant shadow-sm">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Vigentes</span>
                <p class="font-title-lg text-title-lg text-secondary font-bold">@Model.Count(o => o.GarantiaVigente)</p>
            </div>
            <div class="bg-white px-md py-sm rounded-lg border border-outline-variant shadow-sm">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Vencendo em 15 dias</span>
                <p class="font-title-lg text-title-lg text-primary font-bold">@Model.Count(o => o.GarantiaVigente && o.DiasDeGarantiaRestantes <= 15)</p>
            </div>
            <div class="bg-white px-md py-sm rounded-lg border border-outline-variant shadow-sm">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Com retorno</span>
                <p class="font-title-lg text-title-lg text-primary font-bold">@retornos.Count</p>
            </div>
        </section>

        <!-- Barra de ferramentas -->
        <section class="bg-white rounded-t-xl border border-b-0 border-outline-variant p-sm flex flex-wrap items-center gap-sm">
            <div class="relative flex-1 min-w-[200px]">
                <input id="filtroBusca" type="text" placeholder="Pesquisar por cliente, aparelho ou número da OS..."
                       class="w-full bg-surface-container-low border-none rounded-full pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
            </div>
            <select id="filtroSituacao" class="bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                <option value="">Todas</option>
                <option value="Vigente">Vigente</option>
                <option value="Vencida">Vencida</option>
            </select>
        </section>

        <!-- Tabela -->
        <section class="bg-white rounded-b-xl border border-outline-variant shadow-sm overflow-hidden">
            <div class="px-lg py-xs border-b border-outline-variant">
                <span id="contagemInfo" class="font-label-sm text-label-sm text-outline"></span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container-low">
                        <tr>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">OS</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Cliente</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Aparelho</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">O que foi feito</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Retirada</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Vale até</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center">Garantia</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center w-24">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var os in Model)
                        {
                            var cor = Cor(os);
                            var dias = os.DiasDeGarantiaRestantes ?? 0;
                            var qtdRetornos = retornos.TryGetValue(os.Id, out var r) ? r : 0;
                            <tr class="linha-garantia border-t border-outline-variant hover:bg-surface-container-low transition-colors"
                                data-busca="@($"{os.Numero} {os.Cliente.Nome} {os.AparelhosResumo}".ToLower())"
                                data-situacao="@os.SituacaoGarantia">
                                <td class="px-md py-sm font-body-md text-body-md font-semibold text-primary">
                                    @os.Numero
                                    @if (os.OrdemOrigemId.HasValue)
                                    {
                                        <span class="block font-label-sm text-label-sm text-outline">retorno da @os.OrdemOrigem?.Numero</span>
                                    }
                                </td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface">@os.Cliente.Nome</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">@os.AparelhosResumo</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">
                                    @string.Join(", ", os.Itens.Take(2).Select(i => i.Descricao))@(os.Itens.Count > 2 ? "..." : "")
                                </td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">@os.DataEntrega?.ToString("dd/MM/yyyy")</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">
                                    @os.GarantiaFim?.ToString("dd/MM/yyyy")
                                    <span class="block font-label-sm text-label-sm text-outline">@os.PrazoGarantiaDias dias</span>
                                </td>
                                <td class="px-md py-sm text-center">
                                    <span class="px-sm py-xs rounded-full font-label-sm text-label-sm @cor.fundo @cor.texto">
                                        @if (os.GarantiaVigente)
                                        {
                                            <text>@dias @(dias == 1 ? "dia" : "dias")</text>
                                        }
                                        else
                                        {
                                            <text>Vencida</text>
                                        }
                                    </span>
                                    @if (qtdRetornos > 0)
                                    {
                                        <span class="block font-label-sm text-label-sm text-error mt-xs">
                                            @qtdRetornos @(qtdRetornos == 1 ? "retorno" : "retornos")
                                        </span>
                                    }
                                </td>
                                <td class="px-md py-sm">
                                    <div class="flex items-center justify-center gap-xs">
                                        <a asp-controller="Orcamento" asp-action="Ver" asp-route-id="@os.Id" title="Ver a ordem"
                                           class="w-8 h-8 rounded-lg hover:bg-surface-container-high inline-flex items-center justify-center text-on-surface-variant transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        @if (os.GarantiaVigente)
                                        {
                                            <a asp-controller="Orcamento" asp-action="RetornoGarantia" asp-route-id="@os.Id"
                                               title="Abrir retorno em garantia — cria uma OS nova com o cliente e o aparelho já preenchidos"
                                               class="w-8 h-8 rounded-lg hover:bg-secondary-container inline-flex items-center justify-center text-on-surface-variant transition-colors">
                                                <span class="material-symbols-outlined text-[18px]">assignment_return</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="vazioState" class="@(Model.Count == 0 ? "" : "hidden") p-xl text-center">
                <span class="material-symbols-outlined text-[40px] text-outline">verified_user</span>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    @(Model.Count == 0
                        ? "Nenhuma ordem entregue ainda. A garantia começa a contar na retirada do aparelho."
                        : "Nenhuma garantia encontrada para esse filtro.")
                </p>
            </div>
        </section>

        <p class="mt-md font-label-sm text-label-sm text-outline">
            O prazo padrão é de @ListasCompras.Models.OrdemServico.PrazoGarantiaPadrao dias, o mínimo
            do CDC (art. 26, II) para serviço durável — o mesmo que a ordem impressa promete. Dá para
            aumentar o prazo em cada ordem, nunca reduzir.
        </p>
    </main>

    <script src="~/js/garantia.js" asp-append-version="true"></script>
</body>
</html>
