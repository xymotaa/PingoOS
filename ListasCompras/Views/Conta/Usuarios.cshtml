@model List<ListasCompras.Models.Usuario>
@using System.Security.Claims
@using ListasCompras.Models
@{
    Layout = null;
    ViewData["Title"] = "Usuários";
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var meuId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Usuários</title>
    @await Html.PartialAsync("_HeadTailwind")
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>@TempData["Sucesso"]</span>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="mb-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@TempData["Erro"]</span>
            </div>
        }

        <section class="mb-md flex flex-wrap items-end justify-between gap-md">
            <div>
                <h1 class="font-headline-lg text-headline-lg text-primary">Usuários</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Quem pode entrar no sistema da loja.</p>
            </div>
            <a asp-action="NovoUsuario"
               class="h-9 px-md rounded-lg bg-secondary text-white flex items-center justify-center gap-xs hover:bg-opacity-90 transition-colors">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                <span class="font-label-md text-label-md font-bold">Novo usuário</span>
            </a>
        </section>

        <section class="bg-white rounded-xl border border-outline-variant shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Nome</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">E-mail</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Papel</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Situação</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var souEu = meuId == u.Id.ToString();
                            <tr class="border-t border-outline-variant">
                                <td class="px-md py-sm font-body-md text-body-md">
                                    @u.Nome
                                    @if (souEu)
                                    {
                                        <span class="ml-xs font-label-sm text-label-sm text-outline">(você)</span>
                                    }
                                </td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">@u.Email</td>
                                <td class="px-md py-sm">
                                    <span class="px-sm py-xs rounded-full font-label-sm text-label-sm @(u.Papel == Papeis.Admin ? "bg-secondary-container text-on-secondary-container" : "bg-surface-container-high text-on-surface-variant")">
                                        @Papeis.Rotulo(u.Papel)
                                    </span>
                                </td>
                                <td class="px-md py-sm font-body-md text-body-md @(u.Ativo ? "text-secondary" : "text-outline")">
                                    @(u.Ativo ? "Ativo" : "Inativo")
                                </td>
                                <td class="px-md py-sm">
                                    <div class="flex items-center justify-end gap-xs">
                                        <button type="button" onclick="abrirRedefinir(@u.Id, '@u.Nome')"
                                                class="px-sm py-xs rounded-lg border border-outline text-on-surface-variant font-label-sm text-label-sm hover:bg-surface-container-low transition-colors">
                                            Redefinir senha
                                        </button>
                                        <form asp-action="GerarCodigo" method="post" class="inline"
                                              onsubmit="return confirm('Gerar um código novo para @u.Nome? O código anterior deixa de valer.');">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit"
                                                    class="px-sm py-xs rounded-lg border border-outline text-on-surface-variant font-label-sm text-label-sm hover:bg-surface-container-low transition-colors">
                                                Novo código
                                            </button>
                                        </form>
                                        @if (!souEu)
                                        {
                                            <form asp-action="AlternarAtivo" method="post" class="inline">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit"
                                                        class="px-sm py-xs rounded-lg border border-outline text-on-surface-variant font-label-sm text-label-sm hover:bg-surface-container-low transition-colors">
                                                    @(u.Ativo ? "Desativar" : "Ativar")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <p class="mt-md font-label-sm text-label-sm text-outline">
            Usuários não são excluídos, apenas desativados — assim o histórico de quem registrou cada
            ordem de serviço continua fazendo sentido. Você não pode desativar a própria conta.
        </p>
    </main>

    <!-- Redefinir senha -->
    <div id="modalRedefinir" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-md">
        <div class="bg-white rounded-xl border border-outline-variant shadow-lg p-lg w-full max-w-[400px]">
            <h2 class="font-title-lg text-title-lg text-primary mb-md">Redefinir senha de <span id="nomeAlvo"></span></h2>
            <form asp-action="RedefinirSenha" method="post" class="flex flex-col gap-md">
                <input type="hidden" name="id" id="idAlvo" />
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant" for="novaSenha">Nova senha</label>
                    <input id="novaSenha" name="senha" type="password" required minlength="6"
                           class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-on-surface-variant" for="novaConfirmacao">Confirmar</label>
                    <input id="novaConfirmacao" name="confirmacao" type="password" required minlength="6"
                           class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                </div>
                <div class="flex justify-end gap-sm">
                    <button type="button" onclick="fecharRedefinir()"
                            class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="bg-secondary text-white rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors">
                        Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/ui-transicoes.js" asp-append-version="true"></script>
    <script>
        const modal = document.getElementById("modalRedefinir");
        const transicaoModalRedefinir = UiTransicoes.modal(modal);
        function abrirRedefinir(id, nome) {
            document.getElementById("idAlvo").value = id;
            document.getElementById("nomeAlvo").textContent = nome;
            transicaoModalRedefinir.abrir();
            document.getElementById("novaSenha").focus();
        }
        function fecharRedefinir() { transicaoModalRedefinir.fechar(); }
        modal.addEventListener("click", function (e) { if (e.target === modal) fecharRedefinir(); });
    </script>
</body>
</html>
