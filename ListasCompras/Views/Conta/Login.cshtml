@{
    Layout = null;
    ViewData["Title"] = "Entrar";
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var erro = ViewData["Erro"] as string;
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Entrar — @nomeLoja</title>
    @await Html.PartialAsync("_HeadTailwind")
</head>
<body class="bg-surface">

    <div class="min-h-screen grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">

        <!-- Card -->
        <main class="flex items-center justify-center px-lg py-xl">
            <div class="w-full max-w-[380px]">

                <h1 class="font-display-lg text-display-lg text-primary">Pingo OS</h1>
                <p class="font-body-md text-body-md text-on-surface-variant mb-lg">
                    Use o e-mail e a senha cadastrados para fazer o login.
                </p>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="mb-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]">error</span>
                        <span>@erro</span>
                    </div>
                }

                <form asp-action="Login" method="post" class="flex flex-col gap-md">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant" for="email">E-mail</label>
                        <input id="email" name="email" type="email" required autofocus autocomplete="username"
                               class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2.5 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                    </div>

                    <div>
                        <label class="font-label-md text-label-md text-on-surface-variant" for="senha">Senha</label>
                        <input id="senha" name="senha" type="password" required autocomplete="current-password"
                               class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2.5 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                    </div>

                    <button type="submit"
                            class="mt-xs bg-secondary text-white rounded-full px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors flex items-center justify-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]">login</span>
                        Entrar
                    </button>
                </form>

                <div class="mt-lg pt-md border-t border-outline-variant">
                    <a asp-action="EsqueciSenha" class="font-label-md text-label-md text-secondary font-bold hover:underline">
                        Esqueci minha senha
                    </a>
                </div>
            </div>
        </main>

        @await Html.PartialAsync("_PainelIlustracao")
    </div>

</body>
</html>
