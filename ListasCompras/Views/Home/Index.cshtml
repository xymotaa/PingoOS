@model ListasCompras.Models.PainelViewModel
@{
    Layout = null;
    ViewData["Title"] = "Painel";

    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var logo = ViewData["LogoLoja"] as string;
    var inicial = string.IsNullOrWhiteSpace(nomeLoja) ? "L" : nomeLoja.Trim()[0].ToString().ToUpper();

    var hora = DateTime.Now.Hour;
    var saudacao = hora < 12 ? "Bom dia" : hora < 18 ? "Boa tarde" : "Boa noite";

    string Moeda(decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
    var diasSemana = new[] { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" };
    var maiorValorSemana = Model.DesempenhoSemanal.Count > 0 ? Model.DesempenhoSemanal.Max(p => p.Total) : 0m;
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — Painel</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary-container": "#93baa7", "outline-variant": "#bfc9c3",
                        "on-tertiary-fixed-variant": "#294e3f", "surface": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff", "outline": "#707974", "on-primary": "#ffffff",
                        "secondary": "#006c49", "error-container": "#ffdad6", "primary-fixed-dim": "#95d3ba",
                        "on-secondary": "#ffffff", "inverse-primary": "#95d3ba", "primary": "#003527",
                        "on-error-container": "#93000a", "on-tertiary-fixed": "#002115", "primary-fixed": "#b0f0d6",
                        "on-surface": "#0b1c30", "tertiary-fixed": "#c3ecd7", "on-primary-container": "#80bea6",
                        "surface-container-highest": "#d3e4fe", "on-primary-fixed-variant": "#0b513d",
                        "on-error": "#ffffff", "surface-container-lowest": "#ffffff", "surface-container": "#e5eeff",
                        "secondary-fixed": "#6ffbbe", "surface-container-low": "#eff4ff", "surface-tint": "#2b6954",
                        "background": "#f8f9ff", "on-primary-fixed": "#002117", "primary-container": "#064e3b",
                        "on-background": "#0b1c30", "tertiary-container": "#274b3c", "error": "#ba1a1a",
                        "surface-bright": "#f8f9ff", "inverse-surface": "#213145", "tertiary": "#0e3427",
                        "surface-dim": "#cbdbf5", "on-secondary-fixed-variant": "#005236", "tertiary-fixed-dim": "#a8cfbc",
                        "secondary-fixed-dim": "#4edea3", "surface-container-high": "#dce9ff",
                        "on-secondary-container": "#00714d", "secondary-container": "#6cf8bb",
                        "surface-variant": "#d3e4fe", "on-surface-variant": "#404944", "on-tertiary": "#ffffff",
                        "on-secondary-fixed": "#002113"
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    spacing: { "container-margin": "24px", "lg": "24px", "base": "4px", "gutter": "16px", "sm": "8px", "xs": "4px", "md": "16px", "xl": "32px" },
                    fontFamily: {
                        "body-md": ["Hanken Grotesk"], "headline-md": ["Hanken Grotesk"], "title-lg": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"], "label-sm": ["Hanken Grotesk"], "headline-lg": ["Hanken Grotesk"],
                        "display-lg": ["Hanken Grotesk"], "label-md": ["Hanken Grotesk"]
                    },
                    fontSize: {
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-md": ["22px", { "lineHeight": "30px", "fontWeight": "600" }],
                        "title-lg": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "600" }],
                        "headline-lg": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-lg": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(226, 232, 240, 0.8); }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #bfc9c3; border-radius: 10px; }
    </style>
</head>
<body class="bg-surface custom-scrollbar">
    @await Html.PartialAsync("_Navbar")

    <!-- Menu lateral (módulos) -->
    <aside id="sidebar" class="hidden lg:flex fixed top-16 left-0 bottom-0 w-[236px] bg-surface border-r border-outline-variant flex-col py-md px-sm gap-xs z-40 overflow-y-auto custom-scrollbar">
        @* Caixa é um grupo: clicar abre as duas telas, clicar de novo fecha *@
        <button id="grupoCaixaBtn" type="button" aria-expanded="false" aria-controls="grupoCaixa"
                class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors text-left">
            <span class="material-symbols-outlined text-[22px]">point_of_sale</span>
            <span class="font-body-lg text-body-lg">Caixa</span>
        </button>
        <div id="grupoCaixa" class="hidden flex-col gap-xs">
            <a asp-controller="Caixa" asp-action="Index" class="flex items-center gap-md pl-[52px] pr-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
                <span class="font-body-md text-body-md">Frente de caixa</span>
            </a>
            <a asp-controller="Caixa" asp-action="Vendas" class="flex items-center gap-md pl-[52px] pr-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
                <span class="font-body-md text-body-md">Vendas</span>
            </a>
            <a asp-controller="FechamentoCaixa" asp-action="Index" class="flex items-center gap-md pl-[52px] pr-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
                <span class="font-body-md text-body-md">Fechamento do dia</span>
            </a>
        </div>
        <a asp-controller="Orcamento" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">request_quote</span>
            <span class="font-body-lg text-body-lg">Orçamento</span>
        </a>
        <a asp-controller="OrdemServico" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">receipt_long</span>
            <span class="font-body-lg text-body-lg">Ordem de serviço</span>
        </a>
        <a asp-controller="Servico" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">handyman</span>
            <span class="font-body-lg text-body-lg">Serviços</span>
        </a>
        <a asp-controller="Garantia" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">verified_user</span>
            <span class="font-body-lg text-body-lg">Garantias</span>
        </a>
        <a asp-controller="Estoque" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">inventory_2</span>
            <span class="font-body-lg text-body-lg">Estoque</span>
        </a>
        <a asp-controller="Faturamento" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">trending_up</span>
            <span class="font-body-lg text-body-lg">Faturamento MEI</span>
        </a>
        <a asp-controller="Financeiro" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">account_balance_wallet</span>
            <span class="font-body-lg text-body-lg">Financeiro</span>
        </a>
        <a asp-controller="Cliente" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">group</span>
            <span class="font-body-lg text-body-lg">Clientes</span>
        </a>
        <a asp-controller="ListaCompra" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">shopping_cart</span>
            <span class="font-body-lg text-body-lg">Lista de compra</span>
        </a>
        <a asp-controller="Dashboards" asp-action="Index" class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-[22px]">analytics</span>
            <span class="font-body-lg text-body-lg">Dashboards</span>
        </a>
</aside>

    <!-- Conteúdo -->
    <main class="pt-24 px-lg pb-xl lg:pl-[276px]">
        <!-- Aviso de atualização: só aparece se o VerificarVersao encontrar algo mais novo -->
        <div id="avisoAtualizacao" class="hidden mb-md bg-warning-container text-on-surface px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
            <span class="material-symbols-outlined text-[18px]">system_update</span>
            <span>Há uma versão mais nova do Pingo OS. Baixe o projeto atualizado e rode o instalador de novo para atualizar sem perder os dados.</span>
        </div>

        <!-- Boas-vindas -->
        <section class="mb-xl">
            <div class="flex flex-wrap items-center gap-md mb-xs">
                <h2 class="font-headline-lg text-[26px] font-semibold text-primary">@saudacao, @nomeLoja</h2>
            </div>
        </section>

        <!-- Indicadores -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-xl mb-xl">
            <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-gutter">
                <a asp-controller="Caixa" asp-action="Vendas" class="bg-white p-md rounded-xl border border-outline-variant shadow-sm hover:border-secondary transition-colors">
                    <div class="flex justify-between items-start mb-xs">
                        <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Vendas Hoje</span>
                    </div>
                    <h3 class="font-headline-lg text-[26px] font-semibold text-primary">@Moeda(Model.VendasHoje)</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-sm">
                        @(Model.VendasHoje > 0 ? "Total vendido no dia" : "Nenhuma venda ainda hoje")
                    </p>
                </a>
                <a asp-controller="Estoque" asp-action="Index" class="bg-white p-md rounded-xl border border-outline-variant shadow-sm hover:border-secondary transition-colors">
                    <div class="flex justify-between items-start mb-xs">
                        <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Itens em Falta</span>
                    </div>
                    <h3 class="font-headline-lg text-[26px] font-semibold @(Model.ItensEmFalta > 0 ? "text-error" : "text-primary")">@Model.ItensEmFalta</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-sm">
                        @(Model.ItensEmFalta > 0 ? "Esgotados ou abaixo do mínimo" : "Estoque em dia")
                    </p>
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="bg-white p-md rounded-xl border border-outline-variant shadow-sm hover:border-secondary transition-colors">
                    <div class="flex justify-between items-start mb-xs">
                        <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Novos Clientes</span>
                    </div>
                    <h3 class="font-headline-lg text-[26px] font-semibold text-primary">@Model.NovosClientesHoje</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-sm">
                        @(Model.NovosClientesHoje > 0 ? "Cadastrados hoje" : "Nenhum cadastro hoje")
                    </p>
                </a>
            </div>

            <a asp-controller="Financeiro" asp-action="Index" class="bg-white p-md rounded-xl border border-outline-variant shadow-sm hover:border-secondary transition-colors">
                <div class="flex justify-between items-start mb-xs">
                    <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Contas a Pagar</span>
                </div>
                <h3 class="font-headline-lg text-[26px] font-semibold @(Model.ContasAPagarPendentes > 0 ? "text-error" : "text-primary")">@Moeda(Model.ContasAPagarPendentes)</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-sm">
                    @(Model.ContasAPagarPendentes > 0 ? "Ainda não pagas" : "Nada pendente")
                </p>
            </a>
        </section>

        <!-- Gráfico + atividades -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-xl">
            <div class="lg:col-span-2 bg-white rounded-xl border border-outline-variant overflow-hidden shadow-sm flex flex-col">
                <div class="p-lg border-b border-outline-variant">
                    <h4 class="font-title-lg text-title-lg text-primary">Desempenho Semanal</h4>
                    <p class="font-body-md text-body-md text-on-surface-variant">Vendas e ordens de serviço pagas nos últimos 7 dias</p>
                </div>
                @if (maiorValorSemana <= 0)
                {
                    <div class="flex-1 p-lg min-h-[300px] flex items-center justify-center">
                        <p class="font-body-md text-body-md text-on-surface-variant">Sem dados para exibir ainda.</p>
                    </div>
                }
                else
                {
                    <div class="flex-1 p-lg min-h-[300px] flex items-end justify-between gap-sm">
                        @foreach (var ponto in Model.DesempenhoSemanal)
                        {
                            var alturaPct = maiorValorSemana > 0 ? (double)(ponto.Total / maiorValorSemana) * 100 : 0;
                            // Dia sem nenhuma venda vira uma pastilha baixa e neutra (2%); dia com
                            // valor real, por menor que seja frente ao maior dia da semana, tem um
                            // piso bem mais alto (8%) para nunca parecer "zerado" por engano —
                            // antes os dois casos caíam no mesmo piso e ficavam indistinguíveis.
                            var temVenda = ponto.Total > 0;
                            var altura = temVenda ? Math.Max(alturaPct, 8) : 2;
                            <div class="flex-1 flex flex-col items-center gap-xs h-full justify-end group">
                                <span class="font-label-sm text-label-sm text-on-surface-variant opacity-0 group-hover:opacity-100 transition-opacity">@Moeda(ponto.Total)</span>
                                <div class="w-full rounded-t-md transition-all hover:bg-secondary @(temVenda ? "bg-secondary-container" : "bg-surface-container-high")"
                                     style="height: @altura%"
                                     title="@ponto.Dia.ToString("dd/MM") — @Moeda(ponto.Total)"></div>
                                <span class="font-label-sm text-label-sm text-outline">@diasSemana[(int)ponto.Dia.DayOfWeek]</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="bg-white rounded-xl border border-outline-variant shadow-sm flex flex-col">
                <div class="p-lg border-b border-outline-variant">
                    <h4 class="font-title-lg text-title-lg text-primary">Atividades Recentes</h4>
                </div>
                @if (Model.AtividadesRecentes.Count == 0)
                {
                    <div class="flex-1 overflow-y-auto max-h-[400px] custom-scrollbar flex items-center justify-center p-lg">
                        <p class="font-body-md text-body-md text-on-surface-variant text-center">Nenhuma atividade recente.</p>
                    </div>
                }
                else
                {
                    <div class="flex-1 overflow-y-auto max-h-[400px] custom-scrollbar">
                        @foreach (var atv in Model.AtividadesRecentes)
                        {
                            <a href="@atv.Url" class="flex items-start gap-sm px-lg py-sm border-b border-outline-variant last:border-0 hover:bg-surface-container-low transition-colors">
                                <span class="material-symbols-outlined text-[18px] text-secondary mt-[2px]">@atv.Icone</span>
                                <div class="min-w-0">
                                    <p class="font-body-md text-body-md text-on-surface truncate">@atv.Descricao</p>
                                    <p class="font-label-sm text-label-sm text-outline">@atv.Data.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </a>
                        }
                    </div>
                }
                <div class="p-md border-t border-outline-variant text-center">
                    <a asp-controller="Dashboards" asp-action="Index" class="font-label-md text-label-md text-secondary font-bold hover:underline">Ver todo o histórico</a>
                </div>
            </div>
        </section>

        <!-- Tabela: últimos orçamentos -->
        <section class="mt-xl bg-white rounded-xl border border-outline-variant shadow-sm overflow-hidden">
            <div class="p-lg flex justify-between items-center">
                <h4 class="font-title-lg text-title-lg text-primary">Últimos Orçamentos</h4>
                <a asp-controller="Orcamento" asp-action="Add" class="bg-secondary text-white px-md py-sm rounded-lg font-label-md text-label-md hover:bg-opacity-90 transition-all flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Novo Orçamento
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-surface-container-low border-y border-outline-variant">
                            <th class="px-lg py-md font-label-md text-label-md text-outline uppercase">Número</th>
                            <th class="px-lg py-md font-label-md text-label-md text-outline uppercase">Cliente</th>
                            <th class="px-lg py-md font-label-md text-label-md text-outline uppercase">Data</th>
                            <th class="px-lg py-md font-label-md text-label-md text-outline uppercase">Valor</th>
                            <th class="px-lg py-md font-label-md text-label-md text-outline uppercase">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        @if (Model.UltimosOrcamentos.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-lg py-xl text-center font-body-md text-body-md text-on-surface-variant">Nenhum orçamento cadastrado ainda.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var orc in Model.UltimosOrcamentos)
                            {
                                (string fundo, string texto) cor = orc.Situacao switch
                                {
                                    "Aprovado" => ("bg-secondary-container", "text-on-secondary-container"),
                                    "Recusado" => ("bg-surface-container-high", "text-on-surface-variant"),
                                    _ => ("bg-warning-container", "text-on-surface"),
                                };
                                <tr class="hover:bg-surface-container-low transition-colors cursor-pointer" onclick="location.href='@Url.Action("Ver", "Orcamento", new { id = orc.Id })'">
                                    <td class="px-lg py-md font-body-md text-body-md font-semibold text-primary">@orc.Numero</td>
                                    <td class="px-lg py-md font-body-md text-body-md text-on-surface">@orc.Cliente.Nome</td>
                                    <td class="px-lg py-md font-body-md text-body-md text-on-surface-variant">@orc.DataAbertura.ToString("dd/MM/yyyy")</td>
                                    <td class="px-lg py-md font-body-md text-body-md font-semibold text-secondary">@Moeda(orc.Total)</td>
                                    <td class="px-lg py-md">
                                        <span class="px-sm py-xs rounded-full font-label-sm text-label-sm @cor.fundo @cor.texto">@orc.Situacao</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        // Grupo Caixa: fechado por padrão, abre e fecha no clique
        (function () {
            const botao = document.getElementById("grupoCaixaBtn");
            const grupo = document.getElementById("grupoCaixa");
            if (!botao || !grupo) return;

            botao.addEventListener("click", function () {
                const aberto = !grupo.classList.contains("hidden");
                grupo.classList.toggle("hidden", aberto);
                grupo.classList.toggle("flex", !aberto);
                botao.setAttribute("aria-expanded", String(!aberto));
            });
        })();

        // Checa a versão depois que o Painel já carregou — nunca atrasa a tela esperando
        // o GitHub responder. Técnico recebe 403 do endpoint (só Admin decide atualizar) e
        // o catch engole isso em silêncio, sem mostrar erro nenhum na tela.
        (function () {
            fetch("/Home/VerificarVersao")
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (dados) {
                    if (dados && dados.atualizacaoDisponivel) {
                        document.getElementById("avisoAtualizacao").classList.remove("hidden");
                    }
                })
                .catch(function () { /* sem internet ou GitHub fora do ar: sem aviso, sem erro */ });
        })();
    </script>
</body>
</html>
