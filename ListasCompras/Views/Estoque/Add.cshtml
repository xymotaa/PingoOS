@model ListasCompras.Models.ProdutoEstoque
@{
    Layout = null;
    ViewData["Title"] = "Cadastrar novo produto";

    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary-container": "#93baa7", "outline-variant": "#bfc9c3",
                        "on-tertiary-fixed-variant": "#294e3f", "surface": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff", "outline": "#707974", "on-primary": "#ffffff",
                        "secondary": "#006c49", "error-container": "#ffdad6", "primary-fixed-dim": "#95d3ba",
                        "on-secondary": "#ffffff", "inverse-primary": "#95d3ba", "primary": "#003527",
                        "on-error-container": "#93000a", "on-tertiary-fixed": "#002115", "primary-fixed": "#b0f0d6",
                        "on-surface": "#0b1c30", "tertiary-fixed": "#c3ecd7", "on-primary-container": "#80bea6",
                        "surface-container-highest": "#d3e4fe", "on-primary-fixed-variant": "#0b513d",
                        "on-error": "#ffffff", "surface-container-lowest": "#ffffff", "surface-container": "#e5eeff",
                        "secondary-fixed": "#6ffbbe", "surface-container-low": "#eff4ff", "surface-tint": "#2b6954",
                        "background": "#f8f9ff", "on-primary-fixed": "#002117", "primary-container": "#064e3b",
                        "on-background": "#0b1c30", "tertiary-container": "#274b3c", "error": "#ba1a1a",
                        "surface-bright": "#f8f9ff", "inverse-surface": "#213145", "tertiary": "#0e3427",
                        "surface-dim": "#cbdbf5", "on-secondary-fixed-variant": "#005236", "tertiary-fixed-dim": "#a8cfbc",
                        "secondary-fixed-dim": "#4edea3", "surface-container-high": "#dce9ff",
                        "on-secondary-container": "#00714d", "secondary-container": "#6cf8bb",
                        "surface-variant": "#d3e4fe", "on-surface-variant": "#404944", "on-tertiary": "#ffffff",
                        "on-secondary-fixed": "#002113",
                        "warning": "#8a5300", "warning-container": "#ffddb1"
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    spacing: { "container-margin": "24px", "lg": "24px", "base": "4px", "gutter": "16px", "sm": "8px", "xs": "4px", "md": "16px", "xl": "32px" },
                    fontFamily: {
                        "body-md": ["Hanken Grotesk"], "headline-md": ["Hanken Grotesk"], "title-lg": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"], "label-sm": ["Hanken Grotesk"], "headline-lg": ["Hanken Grotesk"],
                        "display-lg": ["Hanken Grotesk"], "label-md": ["Hanken Grotesk"]
                    },
                    fontSize: {
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-md": ["22px", { "lineHeight": "30px", "fontWeight": "600" }],
                        "title-lg": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "600" }],
                        "headline-lg": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-lg": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        input[type=number] { -moz-appearance: textfield; appearance: textfield; }
        input[type=number]::-webkit-outer-spin-button,
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        /* Alinha os campos: todos os rótulos com a mesma altura */
        main label { display: flex; align-items: center; min-height: 20px; }
        main label .material-symbols-outlined { line-height: 1; }
    </style>
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <form asp-action="Salvar" method="post" id="formProduto" enctype="multipart/form-data">
    <input type="hidden" name="id" value="@Model.Id" />
    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>@TempData["Sucesso"]</span>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="mb-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@TempData["Erro"]</span>
            </div>
        }

        <div id="toast" class="hidden mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
            <span id="toastIcon" class="material-symbols-outlined text-[18px]">check_circle</span>
            <span id="toastMsg"></span>
        </div>

        <!-- Cabeçalho da página -->
        <section class="mb-md">
            <h1 id="npTitulo" class="font-headline-lg text-headline-lg text-primary">Cadastrar novo produto</h1>
            <p id="npSubtitulo" class="font-body-md text-body-md text-on-surface-variant">Preencha os dados básicos e, se quiser, complete as demais etapas.</p>
        </section>

        <div class="bg-white rounded-xl border border-outline-variant shadow-sm flex flex-col overflow-hidden">
            <!-- Abas do cadastro -->
            <div class="flex flex-nowrap border-b border-outline-variant px-sm overflow-x-auto">
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-secondary text-secondary font-semibold transition-colors" data-step="1">Dados básicos</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="2">Características</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="3">Imagens</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="4">Estoque</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="5">Tributação</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="6">Variações</button>
            </div>

            <div class="p-lg">
                <div class="max-w-[960px]">

                    <!-- Etapa 1: Dados básicos -->
                    <div data-step-panel="1">
                        <div class="flex items-end justify-between mb-lg">
                            <h3 class="font-title-lg text-title-lg text-primary">Dados básicos</h3>
                            <span class="font-label-md text-label-md text-error">(*) Campos obrigatórios</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npNome">Nome <span class="text-error">*</span></label>
                                <input id="npNome" name="nome" value="@Model.Nome" type="text" maxlength="120"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCodigo">
                                    Código (SKU)
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Deixe em branco para gerar automaticamente">info</span>
                                </label>
                                <input id="npCodigo" name="codigo" value="@Model.Codigo" type="text" maxlength="40"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npPreco">
                                    Preço venda
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Valor de venda ao cliente">info</span>
                                </label>
                                <input id="npPreco" value="@(Model.Id > 0 ? Model.PrecoVenda.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) : "")" type="text" inputmode="decimal" placeholder="0,00" data-mascara="valor"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>

                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npUnidade">
                                    Unidade
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Unidade de medida">info</span>
                                </label>
                                <input id="npUnidade" name="unidade" value="@Model.Unidade" type="text" placeholder="Un, Pç, Kg" maxlength="10"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npFormato">
                                    Formato
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Produto simples ou com variações">info</span>
                                </label>
                                <select id="npFormato" name="formato" class="w-full mt-xs bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="simples" selected="@(Model.Formato != "variacao")">Simples</option>
                                    <option value="variacao" selected="@(Model.Formato == "variacao")">Com variação</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npTipo">Tipo</label>
                                <select id="npTipo" name="tipo" class="w-full mt-xs bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="produto" selected="@(Model.Tipo != "servico")">Produto</option>
                                    <option value="servico" selected="@(Model.Tipo == "servico")">Serviço</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCondicao">
                                    Condição
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Condição do produto">info</span>
                                </label>
                                <select id="npCondicao" name="condicao" class="w-full mt-xs bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="nao_especificado" selected="@(Model.Condicao == "nao_especificado")">Não Especificado</option>
                                    <option value="novo" selected="@(Model.Condicao == "novo")">Novo</option>
                                    <option value="usado" selected="@(Model.Condicao == "usado")">Usado</option>
                                </select>
                            </div>

                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCategoria">
                                    Categoria
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Categoria do produto">info</span>
                                </label>
                                <div class="flex items-center gap-xs mt-xs">
                                    <select id="npCategoria" name="categoriaId" data-categoria-select class="w-full bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                        <option value="">Sem categoria</option>
                                        @foreach (var c in (List<ListasCompras.Models.Categoria>)ViewBag.Categorias)
                                        {
                                            <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nome</option>
                                        }
                                    </select>
                                    <button type="button" data-abre-nova-categoria title="Nova categoria"
                                            class="shrink-0 w-9 h-9 rounded-lg border border-outline-variant hover:bg-surface-container-low inline-flex items-center justify-center text-secondary transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">add</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 2: Características -->
                    <div data-step-panel="2" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Características</h3>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-12">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npDescricao">Descrição complementar</label>
                                <textarea id="npDescricao" name="descricao" rows="3" placeholder="Detalhes do produto, especificações, observações..."
                                          class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">@Model.Descricao</textarea>
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npMarca">Marca</label>
                                <input id="npMarca" name="marca" value="@Model.Marca" type="text" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npModeloRef">Modelo / Referência</label>
                                <input id="npModeloRef" name="modeloRef" value="@Model.ModeloRef" type="text" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npGtin">GTIN / EAN</label>
                                <input id="npGtin" name="gtin" value="@Model.Gtin" type="text" inputmode="numeric" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npPeso">Peso (kg)</label>
                                <input id="npPeso" name="peso" value="@Model.Peso?.ToString(System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" type="text" inputmode="decimal" placeholder="0,000" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npLargura">Largura (cm)</label>
                                <input id="npLargura" name="largura" value="@Model.Largura?.ToString(System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npAltura">Altura (cm)</label>
                                <input id="npAltura" name="altura" value="@Model.Altura?.ToString(System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npProfundidade">Profundidade (cm)</label>
                                <input id="npProfundidade" name="profundidade" value="@Model.Profundidade?.ToString(System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-12">
                                <label class="font-label-md text-label-md text-on-surface-variant">Modelos de celular compatíveis</label>
                                <p class="font-label-sm text-label-sm text-outline mb-xs">Opcional. Deixe em branco se o produto não é específico de um modelo (ex: cabo USB-C genérico).</p>
                                <div id="modelosCompativeisWrap" class="relative">
                                    <input id="modelosCompativeisBusca" type="text" placeholder="Buscar por marca ou modelo (ex: Galaxy A12, Samsung...)"
                                           class="w-full bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                                    <div id="modelosCompativeisResultados" class="hidden absolute z-10 mt-xs w-full max-h-64 overflow-y-auto bg-white border border-outline-variant rounded-lg shadow-lg"></div>
                                </div>
                                <div id="modelosCompativeisChips" class="flex flex-wrap gap-xs mt-sm"></div>
                                <div id="modelosCompativeisInputs"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 3: Imagens -->
                    <div data-step-panel="3" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Imagens</h3>
                        <div class="flex items-start gap-md">
                            <div class="relative">
                                <label for="npFotoInput" class="flex flex-col items-center justify-center gap-xs w-[180px] h-[180px] bg-surface-container-low border-2 border-dashed border-outline-variant rounded-xl cursor-pointer hover:border-secondary transition-colors overflow-hidden">
                                    <img id="npFotoPreview" src="@(Model.Imagem != null ? Url.Content("~/uploads/produtos/" + Model.Imagem) : "")" alt="Imagem do produto"
                                         class="@(Model.Imagem == null ? "hidden" : "") w-full h-full object-contain" />
                                    <div id="npFotoPlaceholder" class="@(Model.Imagem != null ? "hidden" : "") flex flex-col items-center gap-xs text-outline p-md text-center">
                                        <span class="material-symbols-outlined text-[40px]">add_photo_alternate</span>
                                        <p class="font-body-md text-body-md text-on-surface-variant">Arraste ou clique para selecionar</p>
                                        <p class="font-label-sm text-label-sm text-outline">PNG, JPG ou WEBP até 8 MB</p>
                                    </div>
                                </label>
                                <input id="npFotoInput" type="file" name="foto" accept="image/jpeg,image/png,image/webp" class="hidden" />
                                <button id="npFotoRemoverBtn" type="button" title="Remover imagem"
                                        class="@(Model.Imagem == null ? "hidden" : "") absolute -top-2 -right-2 w-7 h-7 rounded-full bg-error text-white flex items-center justify-center shadow hover:bg-opacity-90 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">close</span>
                                </button>
                            </div>
                        </div>
                        <input type="hidden" name="removerFoto" id="npRemoverFotoInput" value="false" />
                    </div>

                    <!-- Etapa 4: Estoque -->
                    <div data-step-panel="4" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Estoque</h3>
                        <div id="npEstoqueSimplesWrap" class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueInicial">@(Model.Id > 0 ? "Estoque atual" : "Estoque inicial")</label>
                                <input id="npEstoqueInicial" name="estoqueInicial" value="@(Model.Id > 0 ? Model.SaldoAtual.ToString() : "")" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueMinimo">Estoque mínimo</label>
                                <input id="npEstoqueMinimo" name="estoqueMinimo" value="@(Model.EstoqueMinimo > 0 ? Model.EstoqueMinimo.ToString() : "")" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueMaximo">Estoque máximo</label>
                                <input id="npEstoqueMaximo" name="estoqueMaximo" value="@(Model.EstoqueMaximo > 0 ? Model.EstoqueMaximo.ToString() : "")" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                        <div id="npEstoqueVariacaoAviso" class="hidden bg-surface-container-low rounded-xl px-lg py-xl flex flex-col items-center justify-center text-center gap-sm">
                            <span class="material-symbols-outlined text-[40px] text-outline">inventory_2</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">Este produto tem variações — o saldo é a soma do estoque de cada uma.</p>
                            <p class="font-label-sm text-label-sm text-outline">Configure o estoque de cada variação na etapa "Variações".</p>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md mt-md">
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCusto">Custo unitário</label>
                                <input id="npCusto" value="@(Model.Id > 0 ? Model.CustoUnitario.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) : "")" type="text" inputmode="decimal" placeholder="0,00" data-mascara="valor" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npLocalizacao">Localização no estoque</label>
                                <input id="npLocalizacao" name="localizacao" value="@Model.Localizacao" type="text" placeholder="Ex: Prateleira A3, Gaveta 2..." class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 5: Tributação -->
                    <div data-step-panel="5" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Tributação</h3>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npOrigem">Origem</label>
                                <select id="npOrigem" name="origemFiscal" class="w-full mt-xs bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="0" selected="@(Model.OrigemFiscal == 0)">0 - Nacional</option>
                                    <option value="1" selected="@(Model.OrigemFiscal == 1)">1 - Estrangeira (importação direta)</option>
                                    <option value="2" selected="@(Model.OrigemFiscal == 2)">2 - Estrangeira (adquirida no mercado interno)</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npNcm">NCM</label>
                                <input id="npNcm" name="ncm" value="@Model.Ncm" type="text" inputmode="numeric" placeholder="0000.00.00" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCest">CEST</label>
                                <input id="npCest" name="cest" value="@Model.Cest" type="text" inputmode="numeric" placeholder="00.000.00" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCfop">CFOP</label>
                                <input id="npCfop" name="cfop" value="@Model.Cfop" type="text" inputmode="numeric" placeholder="5102" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 6: Variações -->
                    <div data-step-panel="6" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Variações</h3>

                        <div id="npVariacoesAviso" class="hidden bg-surface-container-low rounded-xl px-lg py-xl flex flex-col items-center justify-center text-center gap-sm">
                            <span class="material-symbols-outlined text-[40px] text-outline">tune</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">Disponível apenas para produtos com o formato "Com variação".</p>
                        </div>

                        <div id="npVariacoesWrap" class="hidden">
                            <div class="flex items-start justify-between gap-md mb-md">
                                <p class="font-label-sm text-label-sm text-outline max-w-[420px]">
                                    Deixe o código em branco para gerar automaticamente. Deixe o preço em
                                    branco para herdar o preço do produto principal.
                                </p>
                                <button id="npAddVariacaoBtn" type="button"
                                        class="shrink-0 border border-outline text-secondary rounded-lg px-md py-xs font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors flex items-center gap-xs">
                                    <span class="material-symbols-outlined text-[18px]">add</span> Adicionar variação
                                </button>
                            </div>
                            <div class="overflow-x-auto rounded-xl border border-outline-variant">
                                <table class="w-full text-left border-collapse min-w-[760px]">
                                    <thead>
                                        <tr class="bg-surface-container-low border-b border-outline-variant">
                                            <th class="w-[30%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Descrição</th>
                                            <th class="w-[16%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Código</th>
                                            <th class="w-[14%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Preço</th>
                                            <th class="w-[13%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Estoque</th>
                                            <th class="w-[13%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Mínimo</th>
                                            <th class="w-[13%] px-sm py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Máximo</th>
                                            <th class="w-9 px-sm py-sm"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="npVariacoesBody" class="divide-y divide-outline-variant"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    </div>
                </div>

                <!-- Rodapé de ações -->
                <div class="border-t border-outline-variant px-lg py-md flex items-center justify-between gap-sm">
                    <a asp-controller="Estoque" asp-action="Index"
                       class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </a>
                    <div class="flex items-center gap-sm">
                        <button id="salvarNovoProdutoBtn" type="submit"
                                class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                            Salvar produto
                        </button>
                        <button id="npAvancarEtapaBtn" type="button"
                                class="bg-secondary text-white rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors flex items-center gap-xs">
                            Avançar
                            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
    </main>
    <input type="hidden" name="preco" id="npPrecoPost" />
    <input type="hidden" name="custo" id="npCustoPost" />
    </form>

    <!-- Modal: nova categoria -->
    <form id="formNovaCategoria">@Html.AntiForgeryToken()</form>
    <div id="modalNovaCategoria" class="hidden fixed inset-0 z-[60] bg-[#0b1c30]/40 flex items-center justify-center p-md">
        <div class="bg-white rounded-xl shadow-lg w-full max-w-[400px] p-lg">
            <div class="flex justify-between items-center mb-md">
                <h2 class="font-title-lg text-title-lg text-primary">Nova categoria</h2>
                <button id="fecharNovaCategoriaBtn" type="button" class="w-8 h-8 rounded-lg hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <label class="font-label-md text-label-md text-on-surface-variant" for="novaCategoriaNome">Nome</label>
            <input id="novaCategoriaNome" type="text" maxlength="60" placeholder="Ex: Capinha, Película, Cabo..."
                   class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
            <p id="novaCategoriaErro" class="hidden mt-xs font-label-sm text-label-sm text-error"></p>
            <a asp-controller="Categoria" asp-action="Index" target="_blank"
               class="block mt-xs font-label-sm text-label-sm text-secondary hover:underline">Gerenciar categorias (editar, excluir)</a>
            <button id="salvarNovaCategoriaBtn" type="button"
                    class="mt-md w-full py-sm rounded-lg font-label-md text-label-md font-bold bg-secondary text-white hover:bg-opacity-90 transition-all">
                Criar categoria
            </button>
        </div>
    </div>

    <script>
        const ESTOQUE_INDEX_URL = "@Url.Action("Index", "Estoque")";
        const EDITAR_CODIGO = @Html.Raw(Json.Serialize(ViewData["EditarCodigo"] as string ?? ""));
        const CATEGORIA_CRIAR_URL = "@Url.Action("Criar", "Categoria")";

        const MARCAS_CELULAR = @Html.Raw(Json.Serialize(
            ((List<ListasCompras.Models.MarcaCelular>)ViewBag.MarcasCelular)
                .Select(m => new {
                    id = m.Id,
                    nome = m.Nome,
                    modelos = m.Modelos.OrderBy(mo => mo.Nome).Select(mo => new { id = mo.Id, nome = mo.Nome })
                })
        ));
        const MODELOS_COMPATIVEIS_SELECIONADOS = @Html.Raw(Json.Serialize((List<int>)ViewBag.ModelosCompativeisIds));

        const EXCLUIR_VARIACAO_URL = "@Url.Action("ExcluirVariacao", "Estoque")";
        const VARIACOES_EXISTENTES = @Html.Raw(Json.Serialize(
            Model.Variacoes.Select(v => new {
                id = v.Id,
                descricao = v.DescricaoVariacao,
                codigo = v.Codigo,
                preco = v.PrecoVenda,
                estoqueAtual = v.SaldoAtual,
                estoqueMinimo = v.EstoqueMinimo > 0 ? v.EstoqueMinimo : (int?)null,
                estoqueMaximo = v.EstoqueMaximo > 0 ? v.EstoqueMaximo : (int?)null,
            })
        ));
    </script>
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/estoque-add.js" asp-append-version="true"></script>
    <script src="~/js/categoria-modal.js" asp-append-version="true"></script>
    <script src="~/js/estoque-modelos-compativeis.js" asp-append-version="true"></script>
</body>
</html>
