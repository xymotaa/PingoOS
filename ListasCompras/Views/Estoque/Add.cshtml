@{
    Layout = null;
    ViewData["Title"] = "Cadastrar novo produto";

    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary-container": "#93baa7", "outline-variant": "#bfc9c3",
                        "on-tertiary-fixed-variant": "#294e3f", "surface": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff", "outline": "#707974", "on-primary": "#ffffff",
                        "secondary": "#006c49", "error-container": "#ffdad6", "primary-fixed-dim": "#95d3ba",
                        "on-secondary": "#ffffff", "inverse-primary": "#95d3ba", "primary": "#003527",
                        "on-error-container": "#93000a", "on-tertiary-fixed": "#002115", "primary-fixed": "#b0f0d6",
                        "on-surface": "#0b1c30", "tertiary-fixed": "#c3ecd7", "on-primary-container": "#80bea6",
                        "surface-container-highest": "#d3e4fe", "on-primary-fixed-variant": "#0b513d",
                        "on-error": "#ffffff", "surface-container-lowest": "#ffffff", "surface-container": "#e5eeff",
                        "secondary-fixed": "#6ffbbe", "surface-container-low": "#eff4ff", "surface-tint": "#2b6954",
                        "background": "#f8f9ff", "on-primary-fixed": "#002117", "primary-container": "#064e3b",
                        "on-background": "#0b1c30", "tertiary-container": "#274b3c", "error": "#ba1a1a",
                        "surface-bright": "#f8f9ff", "inverse-surface": "#213145", "tertiary": "#0e3427",
                        "surface-dim": "#cbdbf5", "on-secondary-fixed-variant": "#005236", "tertiary-fixed-dim": "#a8cfbc",
                        "secondary-fixed-dim": "#4edea3", "surface-container-high": "#dce9ff",
                        "on-secondary-container": "#00714d", "secondary-container": "#6cf8bb",
                        "surface-variant": "#d3e4fe", "on-surface-variant": "#404944", "on-tertiary": "#ffffff",
                        "on-secondary-fixed": "#002113",
                        "warning": "#8a5300", "warning-container": "#ffddb1"
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    spacing: { "container-margin": "24px", "lg": "24px", "base": "4px", "gutter": "16px", "sm": "8px", "xs": "4px", "md": "16px", "xl": "32px" },
                    fontFamily: {
                        "body-md": ["Hanken Grotesk"], "headline-md": ["Hanken Grotesk"], "title-lg": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"], "label-sm": ["Hanken Grotesk"], "headline-lg": ["Hanken Grotesk"],
                        "display-lg": ["Hanken Grotesk"], "label-md": ["Hanken Grotesk"]
                    },
                    fontSize: {
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-md": ["22px", { "lineHeight": "30px", "fontWeight": "600" }],
                        "title-lg": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "600" }],
                        "headline-lg": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-lg": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        input[type=number] { -moz-appearance: textfield; appearance: textfield; }
        input[type=number]::-webkit-outer-spin-button,
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        /* Alinha os campos: todos os rótulos com a mesma altura */
        main label { display: flex; align-items: center; min-height: 20px; }
        main label .material-symbols-outlined { line-height: 1; }
    </style>
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        <div id="toast" class="hidden mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
            <span id="toastIcon" class="material-symbols-outlined text-[18px]">check_circle</span>
            <span id="toastMsg"></span>
        </div>

        <!-- Cabeçalho da página -->
        <section class="mb-md">
            <h1 class="font-headline-lg text-headline-lg text-primary">Cadastrar novo produto</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Preencha os dados básicos e, se quiser, complete as demais etapas.</p>
        </section>

        <div class="bg-white rounded-xl border border-outline-variant shadow-sm flex flex-col overflow-hidden">
            <!-- Abas do cadastro -->
            <div class="flex flex-nowrap border-b border-outline-variant px-sm overflow-x-auto">
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-secondary text-secondary font-semibold transition-colors" data-step="1">Dados básicos</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="2">Características</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="3">Imagens</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="4">Estoque</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="5">Tributação</button>
                <button type="button" class="np-step whitespace-nowrap px-md py-md font-body-md text-body-md border-b-2 border-transparent text-on-surface-variant hover:text-secondary transition-colors" data-step="6">Variações</button>
            </div>

            <div class="p-lg">
                <div class="max-w-[960px]">

                    <!-- Etapa 1: Dados básicos -->
                    <div data-step-panel="1">
                        <div class="flex items-end justify-between mb-lg">
                            <h3 class="font-title-lg text-title-lg text-primary">Dados básicos</h3>
                            <span class="font-label-md text-label-md text-error">(*) Campos obrigatórios</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npNome">Nome <span class="text-error">*</span></label>
                                <input id="npNome" type="text" maxlength="120"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCodigo">
                                    Código (SKU)
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Deixe em branco para gerar automaticamente">info</span>
                                </label>
                                <input id="npCodigo" type="text" maxlength="40"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npPreco">
                                    Preço venda
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Valor de venda ao cliente">info</span>
                                </label>
                                <input id="npPreco" type="text" inputmode="decimal" placeholder="0,00"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>

                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npUnidade">
                                    Unidade
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Unidade de medida">info</span>
                                </label>
                                <input id="npUnidade" type="text" placeholder="Un, Pç, Kg" maxlength="10"
                                       class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npFormato">
                                    Formato
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Produto simples ou com variações">info</span>
                                </label>
                                <select id="npFormato" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="simples">Simples ou com variação</option>
                                    <option value="variacao">Com variação</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npTipo">Tipo</label>
                                <select id="npTipo" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="produto">Produto</option>
                                    <option value="servico">Serviço</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCondicao">
                                    Condição
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Condição do produto">info</span>
                                </label>
                                <select id="npCondicao" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="nao_especificado">Não Especificado</option>
                                    <option value="novo">Novo</option>
                                    <option value="usado">Usado</option>
                                </select>
                            </div>

                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" for="npCategoria">
                                    Categoria
                                    <span class="material-symbols-outlined text-[16px] text-secondary" title="Categoria do produto">info</span>
                                </label>
                                <select id="npCategoria" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="">Sem categoria</option>
                                    <option value="Capinha">Capinha</option>
                                    <option value="Película">Película</option>
                                    <option value="Carregador">Carregador</option>
                                    <option value="Cabo">Cabo</option>
                                    <option value="Fone">Fone</option>
                                    <option value="Acessório">Acessório</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 2: Características -->
                    <div data-step-panel="2" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Características</h3>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-12">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npDescricao">Descrição complementar</label>
                                <textarea id="npDescricao" rows="3" placeholder="Detalhes do produto, especificações, observações..."
                                          class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30"></textarea>
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npMarca">Marca</label>
                                <input id="npMarca" type="text" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npModeloRef">Modelo / Referência</label>
                                <input id="npModeloRef" type="text" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-4">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npGtin">GTIN / EAN</label>
                                <input id="npGtin" type="text" inputmode="numeric" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npPeso">Peso (kg)</label>
                                <input id="npPeso" type="text" inputmode="decimal" placeholder="0,000" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npLargura">Largura (cm)</label>
                                <input id="npLargura" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npAltura">Altura (cm)</label>
                                <input id="npAltura" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npProfundidade">Profundidade (cm)</label>
                                <input id="npProfundidade" type="text" inputmode="decimal" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 3: Imagens -->
                    <div data-step-panel="3" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Imagens</h3>
                        <div class="border-2 border-dashed border-outline-variant rounded-xl px-lg py-xl flex flex-col items-center justify-center text-center gap-sm">
                            <span class="material-symbols-outlined text-[40px] text-outline">add_photo_alternate</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">Arraste imagens aqui ou clique para selecionar</p>
                            <p class="font-label-sm text-label-sm text-outline">PNG ou JPG até 5 MB cada</p>
                        </div>
                        <p class="mt-sm font-label-sm text-label-sm text-outline">O envio das imagens será vinculado ao produto na versão completa do cadastro.</p>
                    </div>

                    <!-- Etapa 4: Estoque -->
                    <div data-step-panel="4" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Estoque</h3>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueInicial">Estoque inicial</label>
                                <input id="npEstoqueInicial" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueMinimo">Estoque mínimo</label>
                                <input id="npEstoqueMinimo" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npEstoqueMaximo">Estoque máximo</label>
                                <input id="npEstoqueMaximo" type="number" min="0" step="1" placeholder="0" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCusto">Custo unitário</label>
                                <input id="npCusto" type="text" inputmode="decimal" placeholder="0,00" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npLocalizacao">Localização no estoque</label>
                                <input id="npLocalizacao" type="text" placeholder="Ex: Prateleira A3, Gaveta 2..." class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 5: Tributação -->
                    <div data-step-panel="5" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Tributação</h3>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                            <div class="md:col-span-6">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npOrigem">Origem</label>
                                <select id="npOrigem" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                    <option value="0">0 - Nacional</option>
                                    <option value="1">1 - Estrangeira (importação direta)</option>
                                    <option value="2">2 - Estrangeira (adquirida no mercado interno)</option>
                                </select>
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npNcm">NCM</label>
                                <input id="npNcm" type="text" inputmode="numeric" placeholder="0000.00.00" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCest">CEST</label>
                                <input id="npCest" type="text" inputmode="numeric" placeholder="00.000.00" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                            <div class="md:col-span-3">
                                <label class="font-label-md text-label-md text-on-surface-variant" for="npCfop">CFOP</label>
                                <input id="npCfop" type="text" inputmode="numeric" placeholder="5102" class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            </div>
                        </div>
                    </div>

                    <!-- Etapa 6: Variações -->
                    <div data-step-panel="6" class="hidden">
                        <h3 class="font-title-lg text-title-lg text-primary mb-lg">Variações</h3>
                        <div class="bg-surface-container-low rounded-xl px-lg py-xl flex flex-col items-center justify-center text-center gap-sm">
                            <span class="material-symbols-outlined text-[40px] text-outline">tune</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">Cadastre variações como cor, tamanho ou capacidade.</p>
                            <p class="font-label-sm text-label-sm text-outline">Disponível para produtos com o formato “Com variação”. A montagem das variações estará na versão completa do cadastro.</p>
                        </div>
                    </div>

                    </div>
                </div>

                <!-- Rodapé de ações -->
                <div class="border-t border-outline-variant px-lg py-md flex items-center justify-between gap-sm">
                    <a asp-controller="Estoque" asp-action="Index"
                       class="border border-outline text-on-surface-variant rounded-full px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </a>
                    <div class="flex items-center gap-sm">
                        <button id="salvarNovoProdutoBtn" type="button"
                                class="border border-secondary text-secondary rounded-full px-lg py-sm font-label-md text-label-md font-bold hover:bg-secondary-container/30 transition-colors">
                            Salvar produto
                        </button>
                        <button id="npAvancarEtapaBtn" type="button"
                                class="bg-secondary text-white rounded-full px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors flex items-center gap-xs">
                            Avançar
                            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
    </main>

    <script>
        const ESTOQUE_INDEX_URL = "@Url.Action("Index", "Estoque")";
    </script>
    <script src="~/js/estoque-add.js" asp-append-version="true"></script>
</body>
</html>
