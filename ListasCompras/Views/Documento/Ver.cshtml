@model ListasCompras.Models.OrdemServico
@{
    Layout = null;
    ViewData["Title"] = Model.Numero;
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var logo = ViewData["LogoLoja"] as string;
    var lojaCnpj = ViewData["LojaCnpj"] as string;
    var lojaEndereco = ViewData["LojaEndereco"] as string;
    var lojaTelefone = ViewData["LojaTelefone"] as string;
    var lojaEmail = ViewData["LojaEmail"] as string;
    var lojaContato = string.Join(" · ", new[] { lojaTelefone, lojaEmail }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var ehOrcamento = Model.EhOrcamento;
    // Preenchido pelo controller quando este orçamento já foi aprovado: [id, número]
    var ordemGerada = ViewData["OrdemGerada"] as string[];

    string Traco(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    string Moeda(decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — @Model.Numero</title>
    @await Html.PartialAsync("_HeadTailwind")
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        input[type=number] { -moz-appearance: textfield; appearance: textfield; }
        input[type=number]::-webkit-outer-spin-button,
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

        /* Impressão: Ordem de Serviço */
        .documento-os { background: #fff; }
        @@media print {
            .no-print { display: none !important; }
            html, body { background: #fff !important; }
            @@page { size: A4; margin: 8mm; }
            /* Na impressão sobra só o documento: o cartão que o emoldura na tela some */
            .moldura, .moldura > div {
                padding: 0 !important; margin: 0 !important; border: none !important;
                box-shadow: none !important; border-radius: 0 !important; max-width: none !important;
            }
        }
        /* O comprovante térmico só existe na hora de imprimir: fica oculto na tela e
           some do A4 quando é a vez dele — os dois nunca saem juntos.
           A regra @@page não aceita escopo por classe, então usa-se uma "named page"
           (suportada em Chrome/Edge/Brave — a base da maioria das impressoras térmicas USB)
           aplicada só ao elemento térmico via a propriedade "page". Em navegadores sem
           suporte, cai no tamanho do @@page A4 padrão — pior encaixe, mas não quebra a impressão. */
        #osTermico { display: none; }
        body.modo-termico #osImpressao { display: none !important; }
        body.modo-termico #osTermico { display: block; }
        @@page termica { size: 80mm auto; margin: 3mm; }
        #osTermico {
            page: termica;
            width: 74mm; color: #000; font-family: 'Courier New', monospace; font-size: 11px;
            line-height: 1.35;
        }
        #osTermico .term-centro { text-align: center; }
        #osTermico .term-titulo { font-size: 13px; font-weight: 700; }
        #osTermico .term-sep { border-top: 1px dashed #000; margin: 6px 0; }
        #osTermico .term-linha { display: flex; justify-content: space-between; gap: 6px; }
        #osTermico .term-rot { font-weight: 700; }
        #osTermico .term-item { margin: 2px 0; }
        #osTermico .term-obs { white-space: pre-wrap; }
        #osTermico .term-rodape { margin-top: 8px; font-size: 10px; text-align: center; }
        #osImpressao { color: #000; font-family: 'Hanken Grotesk', Arial, sans-serif; font-size: 10px; line-height: 1.3; }
        /* Cada "via" é um bloco idêntico; as duas cabem na mesma folha A4 */
        #osImpressao .os-via { page-break-inside: avoid; break-inside: avoid; }
        #osImpressao .os-corte { border-top: 1px dashed #999; text-align: center; margin: 8px 0 10px; }
        #osImpressao .os-corte span { position: relative; top: -8px; background: #fff; padding: 0 8px; font-size: 10px; color: #777; letter-spacing: .04em; }
        #osImpressao .os-topo { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #000; padding-bottom: 4px; margin-bottom: 6px; }
        #osImpressao .os-loja { display: flex; align-items: center; gap: 8px; }
        #osImpressao .os-logo { width: 36px; height: 36px; object-fit: contain; }
        #osImpressao .os-loja-nome { font-size: 14px; font-weight: 700; }
        #osImpressao .os-loja-sub { font-size: 9px; color: #444; }
        #osImpressao .os-doc-meta { text-align: right; font-size: 9px; }
        #osImpressao .os-doc-titulo { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
        #osImpressao .os-via-label { display: inline-block; border: 1px solid #000; padding: 0 5px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }
        #osImpressao .os-bloco { margin-bottom: 5px; }
        #osImpressao .os-bloco-titulo { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; background: #f0f0f0; border: 1px solid #ccc; padding: 1px 8px; margin-bottom: 3px; }
        #osImpressao .os-linhas { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 16px; padding: 0 4px; }
        #osImpressao .os-linhas-3 { grid-template-columns: 2fr 1fr 1fr; }
        #osImpressao .os-linhas-4 { grid-template-columns: repeat(4, 1fr); }
        #osImpressao .os-rot { font-weight: 600; }
        #osImpressao .os-diag { padding: 1px 4px; white-space: pre-wrap; min-height: 22px; }
        #osImpressao .os-tabela { width: 100%; border-collapse: collapse; }
        #osImpressao .os-tabela th, #osImpressao .os-tabela td { border: 1px solid #ccc; padding: 2px 8px; font-size: 10px; }
        #osImpressao .os-tabela th { background: #f0f0f0; }
        /* Termos em texto corrido e justificado, em 2 colunas: ocupa bem menos altura que uma lista */
        #osImpressao .os-termos-texto { column-count: 2; column-gap: 14px; margin: 0; padding: 0 4px; font-size: 7px; line-height: 1.32; text-align: justify; }
        #osImpressao .os-aceite { font-size: 8px; font-weight: 600; margin-top: 3px; padding: 0 4px; }
        #osImpressao .os-assinaturas { display: flex; justify-content: space-between; gap: 40px; margin-top: 16px; }
        #osImpressao .os-assinatura { flex: 1; text-align: center; font-size: 9px; }
        #osImpressao .os-linha-assinatura { border-top: 1px solid #000; margin-bottom: 3px; height: 0; }
    </style>
</head>
<body class="bg-surface">
    <div class="no-print">
        @await Html.PartialAsync("_Navbar")
    </div>

    <main class="no-print pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>@TempData["Sucesso"]</span>
            </div>
        }

        <section class="flex flex-wrap items-end justify-between gap-md">
            <div>
                                <h1 class="font-headline-lg text-headline-lg text-primary">@Model.Numero</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    @Model.Cliente.Nome · @(ehOrcamento ? "feito" : "aberta") em @Model.DataAbertura.ToString("dd/MM/yyyy")
                    @if (Model.DataEntrega.HasValue)
                    {
                        <text>· entregue em @Model.DataEntrega.Value.ToString("dd/MM/yyyy")</text>
                    }
                </p>
                <div class="mt-sm flex flex-wrap items-center gap-sm">
                    @if (ehOrcamento)
                    {
                        <span class="px-sm py-xs rounded-lg font-label-md text-label-md @(Model.ValidadeVencida ? "bg-error-container text-error" : "bg-warning-container text-on-surface")">
                            @if (Model.ValidadeVencida)
                            {
                                <text>Venceu em @Model.Validade.ToString("dd/MM/yyyy") — refaça antes de aprovar</text>
                            }
                            else
                            {
                                <text>Válido até @Model.Validade.ToString("dd/MM/yyyy") (@Model.ValidadeDias dias)</text>
                            }
                        </span>
                        @if (ordemGerada != null)
                        {
                            <a asp-controller="OrdemServico" asp-action="Ver" asp-route-id="@ordemGerada[0]"
                               class="font-label-md text-label-md text-secondary font-bold hover:underline flex items-center gap-xs">
                                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                                Virou a ordem @ordemGerada[1]
                            </a>
                        }
                    }
                    else if (Model.GarantiaIniciada)
                    {
                        <span class="px-sm py-xs rounded-lg font-label-md text-label-md @(Model.GarantiaVigente ? "bg-secondary-container text-on-secondary-container" : "bg-surface-container-high text-on-surface-variant")">
                            @if (Model.GarantiaVigente)
                            {
                                <text>Garantia vigente · vale até @Model.GarantiaFim?.ToString("dd/MM/yyyy") (@Model.DiasDeGarantiaRestantes dias)</text>
                            }
                            else
                            {
                                <text>Garantia vencida em @Model.GarantiaFim?.ToString("dd/MM/yyyy")</text>
                            }
                        </span>
                        @if (Model.GarantiaVigente)
                        {
                            <a asp-action="RetornoGarantia" asp-route-id="@Model.Id"
                               class="font-label-md text-label-md text-secondary font-bold hover:underline flex items-center gap-xs">
                                <span class="material-symbols-outlined text-[18px]">assignment_return</span>
                                Abrir retorno em garantia
                            </a>
                        }
                    }
                    else
                    {
                        <span class="px-sm py-xs rounded-lg font-label-md text-label-md bg-warning-container text-on-surface">
                            Garantia de @Model.PrazoGarantiaDias dias — começa a contar na retirada
                        </span>
                    }
                    @if (!ehOrcamento && Model.OrdemOrigemId.HasValue)
                    {
                        <a asp-action="Ver" asp-route-id="@Model.OrdemOrigemId"
                           class="font-label-md text-label-md text-secondary font-bold hover:underline">
                            Retorno da @Model.OrdemOrigem?.Numero
                        </a>
                    }
                    @if (!ehOrcamento && Model.OrcamentoOrigemId.HasValue)
                    {
                        <a asp-controller="Orcamento" asp-action="Ver" asp-route-id="@Model.OrcamentoOrigemId"
                           class="font-label-md text-label-md text-secondary font-bold hover:underline">
                            Veio do orçamento @Model.OrcamentoOrigem?.Numero
                        </a>
                    }
                </div>

                <form asp-action="AlterarSituacao" method="post" class="mt-sm flex items-center gap-sm">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="retorno" value="Ver" />
                    <label class="font-label-md text-label-md text-on-surface-variant" for="situacao">Situação</label>
                    <select id="situacao" name="situacao" onchange="this.form.submit()"
                            class="bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                        @foreach (var s in Model.SituacoesPossiveis)
                        {
                            <option value="@s" selected="@(Model.Situacao == s)">@s</option>
                        }
                    </select>
                </form>
            </div>
            <div class="flex items-center gap-sm">
            <a asp-action="Add" asp-route-id="@Model.Id"
               class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors flex items-center gap-xs">
                <span class="material-symbols-outlined text-[18px]">edit</span>
                Editar
            </a>
            <button id="imprimirBtn" type="button"
                    class="@(ehOrcamento && ordemGerada == null ? "border border-outline text-on-surface-variant hover:bg-surface-container-low" : "bg-secondary text-white hover:bg-opacity-90") rounded-lg px-lg py-sm font-label-md text-label-md font-bold transition-colors flex items-center gap-xs">
                <span class="material-symbols-outlined text-[18px]">print</span>
                @(ehOrcamento ? "Imprimir" : "Imprimir as duas vias")
            </button>
            @if (!ehOrcamento)
            {
                <button id="imprimirTermicoBtn" type="button" title="Comprovante de entrada em impressora térmica 58/80mm"
                        class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">receipt</span>
                    Comprovante térmico
                </button>
            }
            @if (ehOrcamento && ordemGerada == null)
            {
                <form asp-action="GerarOrdem" method="post"
                      onsubmit="return confirm('O cliente aprovou este orçamento? Vai ser aberta uma ordem de serviço com o mesmo cliente, aparelhos e itens.');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit"
                            class="bg-secondary text-white rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        Cliente aprovou — gerar OS
                    </button>
                </form>
            }
            </div>
        </section>

        <p class="mt-md font-body-md text-body-md text-on-surface-variant">
            @if (ehOrcamento)
            {
                <text>
                    Abaixo está o orçamento como sai na impressora: uma via, sem termos e sem
                    assinatura — nada foi autorizado ainda. Quem promete garantia é a ordem de
                    serviço, gerada quando o cliente aprovar.
                </text>
            }
            else
            {
                <text>
                    Abaixo está o documento como sai na impressora: as duas vias na mesma folha A4,
                    com os termos e a garantia.
                </text>
            }
        </p>

        @if (!ehOrcamento)
        {
            <!-- Fotos do aparelho: evidência do estado na entrada, defesa contra "esse arranhão não estava aí" -->
            <section class="mt-md bg-white rounded-xl border border-outline-variant shadow-sm p-lg">
                <div class="flex items-center gap-sm mb-md">
                    <span class="material-symbols-outlined text-[20px] text-secondary">photo_camera</span>
                    <h2 class="font-title-lg text-title-lg text-primary">Fotos do aparelho</h2>
                </div>
                <div class="flex flex-col gap-lg">
                    @foreach (var ap in Model.Aparelhos)
                    {
                        <div>
                            <div class="flex items-center justify-between gap-sm mb-sm">
                                <span class="font-label-md text-label-md text-on-surface-variant">@ap.Resumo</span>
                                <form asp-controller="OrdemServico" asp-action="EnviarFoto" method="post" enctype="multipart/form-data" class="form-enviar-foto">
                                    <input type="hidden" name="aparelhoId" value="@ap.Id" />
                                    <label class="cursor-pointer inline-flex items-center gap-xs font-label-md text-label-md text-secondary font-bold hover:underline">
                                        <span class="material-symbols-outlined text-[18px]">add_a_photo</span>
                                        Adicionar foto
                                        <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" class="input-foto hidden" />
                                    </label>
                                </form>
                            </div>
                            <div class="grid grid-cols-3 sm:grid-cols-6 gap-sm">
                                @foreach (var foto in ap.Fotos)
                                {
                                    <div class="relative group aspect-square rounded-lg overflow-hidden border border-outline-variant">
                                        <img src="~/uploads/aparelhos/@foto.Arquivo" class="w-full h-full object-cover" />
                                        <form asp-controller="OrdemServico" asp-action="ExcluirFoto" method="post" class="form-excluir-foto absolute top-1 right-1">
                                            <input type="hidden" name="id" value="@foto.Id" />
                                            <button type="submit" class="w-6 h-6 rounded-full bg-black/60 hover:bg-error text-white flex items-center justify-center transition-colors" title="Remover foto">
                                                <span class="material-symbols-outlined text-[16px]">close</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (Model.Aparelhos.Count == 0)
                    {
                        <p class="font-body-md text-body-md text-on-surface-variant">Nenhum aparelho nesta ordem.</p>
                    }
                </div>
            </section>
        }
    </main>

    <div class="moldura px-lg pb-xl max-w-[1440px] mx-auto">
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-lg overflow-x-auto">
    <!-- Documento de impressão: Ordem de Serviço (1ª via impressa aqui; a 2ª é clonada por JS) -->
    <div id="osImpressao" class="documento-os">
      <div class="os-via" id="osVia1">
        <div class="os-topo">
            <div class="os-loja">
                @if (!string.IsNullOrEmpty(logo))
                {
                    <img src="@logo" alt="@nomeLoja" class="os-logo" />
                }
                <div>
                    <div class="os-loja-nome">@nomeLoja</div>
                    @if (!string.IsNullOrWhiteSpace(lojaCnpj)) { <div class="os-loja-sub">CNPJ: @lojaCnpj</div> }
                    @if (!string.IsNullOrWhiteSpace(lojaEndereco)) { <div class="os-loja-sub">@lojaEndereco</div> }
                    @if (!string.IsNullOrWhiteSpace(lojaContato)) { <div class="os-loja-sub">@lojaContato</div> }
                </div>
            </div>
            <div class="os-doc-meta">
                <div class="os-doc-titulo">@(ehOrcamento ? "ORÇAMENTO" : "ORDEM DE SERVIÇO")</div>
                @if (ehOrcamento)
                {
                    <div class="os-via-label">Válido até @Model.Validade.ToString("dd/MM/yyyy")</div>
                }
                else
                {
                    <div class="os-via-label">1ª via — Cliente</div>
                }
                <div>Nº <span id="osNumero">@Model.Numero</span></div>
                <div>Data: <span id="osData">@Model.DataAbertura.ToString("dd/MM/yyyy")</span></div>
            </div>
        </div>

        <div class="os-bloco">
            <div class="os-bloco-titulo">Cliente</div>
            <div class="os-linhas os-linhas-3">
                <div><span class="os-rot">Nome:</span> <span id="osClienteNome">@Model.Cliente.Nome</span></div>
                <div><span class="os-rot">Telefone:</span> <span id="osClienteTelefone">@Traco(Model.Cliente.Telefone)</span></div>
                <div><span class="os-rot">CPF/RG:</span> <span id="osClienteDoc">@Traco(Model.Cliente.Documento)</span></div>
                <div style="grid-column: 1 / -1"><span class="os-rot">Endereço:</span> <span id="osClienteEndereco">@Traco(Model.Cliente.EnderecoCompleto)</span></div>
            </div>
        </div>

        <div class="os-bloco">
            <div class="os-bloco-titulo">@(Model.Aparelhos.Count > 1 ? "Aparelhos" : "Aparelho")</div>
            @foreach (var ap in Model.Aparelhos)
            {
                <div class="os-linhas os-linhas-4">
                    <div><span class="os-rot">Tipo:</span> @Traco(ap.Tipo)</div>
                    <div><span class="os-rot">Marca:</span> @Traco(ap.Marca)</div>
                    <div><span class="os-rot">Modelo:</span> @Traco(ap.Modelo)</div>
                    <div><span class="os-rot">Nº de série:</span> @(ap.SemNumeroSerie ? "Não possui" : Traco(ap.NumeroSerie))</div>
                </div>
            }
            @if (Model.Aparelhos.Count == 0)
            {
                <div class="os-linhas"><div>—</div></div>
            }
        </div>

        <div class="os-bloco">
            <div class="os-bloco-titulo">@(ehOrcamento ? "Serviço solicitado" : "Diagnóstico")</div>
            <div id="osDiagnostico" class="os-diag">@Traco(Model.Diagnostico)</div>
        </div>

        <div class="os-bloco">
            <div class="os-bloco-titulo">Peças e Serviços</div>
            <table class="os-tabela">
                <thead>
                    <tr>
                        <th style="text-align:left">Descrição (Peça / Mão de Obra)</th>
                        <th style="width:56px;text-align:center">Qtd</th>
                        <th style="width:110px;text-align:right">Valor Unit.</th>
                        <th style="width:110px;text-align:right">Total</th>
                    </tr>
                </thead>
                <tbody id="osItens">
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>@item.Descricao</td>
                            <td style="text-align:center">@item.Quantidade</td>
                            <td style="text-align:right">@Moeda(item.ValorUnitario)</td>
                            <td style="text-align:right">@Moeda(item.Total)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align:right">Subtotal</td>
                        <td style="text-align:right">@Moeda(Model.Subtotal)</td>
                    </tr>
                    @if (Model.DescontoEmReais > 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align:right">
                                Desconto@(Model.DescontoTipo == "percentual" ? $" ({Model.Desconto:0.##}%)" : "")
                            </td>
                            <td style="text-align:right">− @Moeda(Model.DescontoEmReais)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3" style="text-align:right;font-weight:700">@(ehOrcamento ? "Total do orçamento" : "Total da ordem")</td>
                        <td id="osTotal" style="text-align:right;font-weight:700">@Moeda(Model.Total)</td>
                    </tr>
                    @if (Model.Sinal > 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align:right">Haver deixado pelo cliente</td>
                            <td style="text-align:right">− @Moeda(Model.Sinal)</td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align:right;font-weight:700">Falta pagar</td>
                            <td style="text-align:right;font-weight:700">@Moeda(Model.SaldoAPagar)</td>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>

        @if (!ehOrcamento && (!string.IsNullOrEmpty(Model.FormaPagamento) || Model.Parcelado))
        {
            <div class="os-bloco">
                <div class="os-bloco-titulo">Pagamento</div>
                <div class="os-linhas">
                    <div>
                        <span class="os-rot">Forma:</span>
                        @(Model.FormaPagamento switch {
                            "dinheiro" => "Dinheiro", "pix" => "PIX",
                            "debito" => "Cartão de débito", "credito" => "Cartão de crédito",
                            _ => "A combinar" })
                    </div>
                    <div>
                        <span class="os-rot">Parcelamento:</span>
                        @(Model.Parcelado && Model.QuantidadeParcelas > 1
                            ? $"{Model.QuantidadeParcelas}x de {Moeda(Model.ValorParcela)}"
                            : "À vista")
                    </div>
                </div>
            </div>
        }

        @if (ehOrcamento)
        {
            <div class="os-bloco os-termos">
                <div class="os-bloco-titulo">Condições</div>
                <p class="os-termos-texto">Este documento é um <b>orçamento</b>: informa preços e não autoriza a execução de nenhum serviço. Válido por @Model.ValidadeDias dias a contar da data acima, sujeito à disponibilidade e ao preço das peças na data da aprovação. Valores estimados a partir do defeito relatado; falhas ocultas, só constatáveis com o aparelho aberto, podem alterar o orçamento, que será submetido de novo ao cliente (CDC, art. 40). Aprovado o orçamento, será emitida <b>Ordem de Serviço</b> com os termos completos, a garantia legal de @ListasCompras.Models.OrdemServico.PrazoGarantiaPadrao dias (CDC, art. 26, II) e a assinatura das partes.</p>
                <div class="os-aceite">Orçado por @(Model.Usuario?.Nome ?? "—") em @Model.DataAbertura.ToString("dd/MM/yyyy")</div>
            </div>
        }
        else
        {
        <div class="os-bloco os-termos">
            <div class="os-bloco-titulo">Termos e condições do serviço</div>
            <p class="os-termos-texto"><b>1. Aprovação prévia.</b> O serviço só é executado após aprovação expressa deste orçamento, válido por 10 dias. Uma vez aprovado, obriga ambas as partes: o cliente que desistir responde pelas peças já aplicadas e pela mão de obra executada (CDC, art. 40, §2º). <b>2. Dados e backup.</b> O backup é de responsabilidade do cliente; o reparo pode exigir formatação ou troca de componentes, não respondendo a empresa por perda de dados. <b>3. Privacidade e sigilo.</b> É vedado ao técnico acessar, copiar, compartilhar ou divulgar arquivos pessoais do aparelho, limitando-se o acesso ao estritamente necessário ao diagnóstico e ao teste do reparo, sob sigilo (Lei 13.709/2018 – LGPD; Código Penal, art. 154-A). <b>4. Garantia.</b> 90 dias sobre o serviço executado e as peças substituídas, contados da retirada, mediante apresentação desta Ordem de Serviço (CDC, art. 26, II). <b>5. Exclusões.</b> A garantia não cobre mau uso, quedas e impactos, contato com líquidos, umidade ou oxidação, sobrecarga da rede elétrica, acessórios não originais, software instalado pelo cliente, desgaste natural, nem defeito em componente diverso do reparado (CDC, art. 14, §3º, II). <b>6. Violação.</b> Abertura, reparo ou tentativa de conserto por terceiro não autorizado, durante o serviço ou no prazo de garantia, cancela a garantia integralmente. <b>7. Riscos.</b> Aparelhos com oxidação, queda ou intervenção anterior podem apresentar falhas ocultas, não detectáveis no diagnóstico inicial, inclusive deixar de ligar durante o reparo; o cliente declara ciência ao autorizar. <b>8. Retirada e abandono.</b> O aparelho deve ser retirado em até 90 dias da comunicação da conclusão ou da recusa do orçamento, sob taxa de armazenagem. Notificado o cliente e decorridos mais 90 dias sem manifestação, o bem será considerado abandonado (Código Civil, art. 1.275, III), autorizada sua destinação para cobrir os custos. <b>9. Identificação.</b> A entrega se dá mediante esta via e documento com foto, ou autorização escrita do cliente.</p>
            <div class="os-aceite">O cliente declara ter lido, compreendido e aceito integralmente os termos acima e autoriza a execução dos serviços descritos nesta Ordem de Serviço.</div>
        </div>

        <div class="os-assinaturas">
            <div class="os-assinatura"><div class="os-linha-assinatura"></div>@Model.Cliente.Nome</div>
            <div class="os-assinatura"><div class="os-linha-assinatura"></div>@(Model.Usuario?.Nome ?? "Responsável Técnico")</div>
        </div>
        }
      </div>

      @* Só a ordem de serviço sai em duas vias: uma para assinar e deixar, outra para levar.
         O orçamento não tem assinatura, então a segunda via seria papel jogado fora. *@
      @if (!ehOrcamento)
      {
          <div class="os-corte" aria-hidden="true"><span>✂ - - - - - - - - - -  corte aqui  - - - - - - - - - -</span></div>

          <!-- 2ª via: preenchida com um clone da 1ª via em gerarSegundaVia() -->
          <div id="osVia2"></div>
      }
    </div>
        </div>
    </div>

    @if (!ehOrcamento)
    {
        <!-- Comprovante térmico (58/80mm): resumo da entrada, não repete os termos completos.
             Fica escondido na tela; só aparece quando body.modo-termico ativa a impressão dele. -->
        <div id="osTermico">
            <div class="term-centro">
                <div class="term-titulo">@nomeLoja</div>
                @if (!string.IsNullOrWhiteSpace(lojaCnpj)) { <div>CNPJ: @lojaCnpj</div> }
                @if (!string.IsNullOrWhiteSpace(lojaContato)) { <div>@lojaContato</div> }
            </div>
            <div class="term-sep"></div>
            <div class="term-centro term-titulo">COMPROVANTE DE ENTRADA</div>
            <div class="term-linha"><span class="term-rot">Nº</span><span>@Model.Numero</span></div>
            <div class="term-linha"><span class="term-rot">Data</span><span>@Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div class="term-sep"></div>
            <div><span class="term-rot">Cliente:</span> @Model.Cliente.Nome</div>
            @if (!string.IsNullOrWhiteSpace(Model.Cliente.Telefone)) { <div><span class="term-rot">Tel:</span> @Model.Cliente.Telefone</div> }
            <div class="term-sep"></div>
            @foreach (var ap in Model.Aparelhos)
            {
                <div class="term-item">
                    <div><span class="term-rot">Aparelho:</span> @Traco(ap.Resumo)</div>
                    <div><span class="term-rot">Série:</span> @(ap.SemNumeroSerie ? "Não possui" : Traco(ap.NumeroSerie))</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Diagnostico))
            {
                <div class="term-sep"></div>
                <div><span class="term-rot">Defeito relatado:</span></div>
                <div class="term-obs">@Model.Diagnostico</div>
            }
            <div class="term-sep"></div>
            <div class="term-linha"><span class="term-rot">Total previsto</span><span>@Moeda(Model.Total)</span></div>
            @if (Model.Sinal > 0)
            {
                <div class="term-linha"><span class="term-rot">Haver pago</span><span>@Moeda(Model.Sinal)</span></div>
                <div class="term-linha"><span class="term-rot">Falta pagar</span><span>@Moeda(Model.SaldoAPagar)</span></div>
            }
            <div class="term-sep"></div>
            <div class="term-obs">Garantia de @Model.PrazoGarantiaDias dias a contar da retirada. A OS completa, com termos e assinatura, é entregue em papel A4 à parte.</div>
            <div class="term-rodape">Guarde este comprovante para retirar o aparelho.</div>
        </div>
    }

    <script src="~/js/os-impressao.js" asp-append-version="true"></script>
    <script src="~/js/fotos-aparelho.js" asp-append-version="true"></script>
</body>
</html>
