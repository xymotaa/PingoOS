@model List<ListasCompras.Models.OrdemServico>
@{
    Layout = null;
    var ehOrcamento = ViewData["EhOrcamento"] as bool? ?? false;
    var titulo = ehOrcamento ? "Orçamentos" : "Ordens de serviço";
    ViewData["Title"] = titulo;
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var situacoes = ehOrcamento
        ? ListasCompras.Models.SituacoesOrcamento.Todas
        : ListasCompras.Models.Situacoes.Todas;

    string Moeda(decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));

    (string fundo, string texto) Cor(string situacao) => situacao switch
    {
        "Entregue" or "Recusado" => ("bg-surface-container-high", "text-on-surface-variant"),
        "Pronta" or "Aprovado" => ("bg-secondary-container", "text-on-secondary-container"),
        _ => ("bg-warning-container", "text-on-surface"),
    };
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@titulo</title>
    @await Html.PartialAsync("_HeadTailwind")
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

        @if (TempData["Sucesso"] != null)
        {
            <div class="mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>@TempData["Sucesso"]</span>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="mb-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@TempData["Erro"]</span>
            </div>
        }

        <!-- Cabeçalho da página -->
        <section class="mb-md">
            <h1 class="font-headline-lg text-headline-lg text-primary">@titulo</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
                @(ehOrcamento
                    ? "Propostas de serviço aguardando aprovação do cliente."
                    : "Aparelhos na bancada: abertos, prontos para retirada e já entregues.")
            </p>
        </section>

        <!-- Barra de ferramentas -->
        <section class="bg-white rounded-t-xl border border-b-0 border-outline-variant p-sm flex flex-wrap items-center gap-sm">
            <div class="relative flex-1 min-w-[200px]">
                <input id="filtroBusca" type="text" placeholder="Pesquisar por número, cliente ou aparelho..."
                       class="w-full bg-surface-container-low border-none rounded-full pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
            </div>

            <select id="filtroSituacao" class="bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                <option value="">Todas as situações</option>
                @foreach (var s in situacoes)
                {
                    <option value="@s">@s</option>
                }
            </select>

            <a asp-action="Add" title="@(ehOrcamento ? "Novo orçamento" : "Nova ordem de serviço")"
               class="h-9 px-md rounded-lg bg-secondary text-white flex items-center justify-center gap-xs hover:bg-opacity-90 transition-colors shrink-0 ml-auto">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span class="font-label-md text-label-md font-bold hidden sm:inline">@(ehOrcamento ? "Novo orçamento" : "Nova OS")</span>
            </a>
        </section>

        <!-- Tabela -->
        <section class="bg-white rounded-b-xl border border-outline-variant shadow-sm overflow-hidden">
            <div class="px-lg py-xs border-b border-outline-variant">
                <span id="contagemInfo" class="font-label-sm text-label-sm text-outline"
                      data-um="@(ehOrcamento ? "orçamento" : "ordem")"
                      data-muitos="@(ehOrcamento ? "orçamentos" : "ordens")"></span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container-low">
                        <tr>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Nº</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Cliente</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Aparelho</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">@(ehOrcamento ? "Feito em" : "Aberta em")</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right">Total</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center">Situação</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center w-32">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var os in Model)
                        {
                            var cor = Cor(os.Situacao);
                            <tr class="linha-os border-t border-outline-variant hover:bg-surface-container-low transition-colors cursor-pointer"
                                onclick="abrirOs(event, '@Url.Action("Ver", new { id = os.Id })')"
                                data-busca="@($"{os.Numero} {os.Cliente.Nome} {os.AparelhosResumo}".ToLower())"
                                data-situacao="@os.Situacao">
                                <td class="px-md py-sm font-body-md text-body-md font-semibold text-primary">@os.Numero</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface">@os.Cliente.Nome</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">@os.AparelhosResumo</td>
                                <td class="px-md py-sm font-body-md text-body-md text-on-surface-variant">@os.DataAbertura.ToString("dd/MM/yyyy")</td>
                                <td class="px-md py-sm font-body-md text-body-md text-right font-semibold text-secondary">@Moeda(os.Total)</td>
                                <td class="px-md py-sm text-center">
                                    <form asp-action="AlterarSituacao" method="post" class="inline">
                                        <input type="hidden" name="id" value="@os.Id" />
                                        <select name="situacao" onchange="this.form.submit()" title="Alterar a situação"
                                                class="cursor-pointer border-none rounded-lg pl-sm pr-8 py-xs font-label-sm text-label-sm @cor.fundo @cor.texto focus:ring-2 focus:ring-secondary/30">
                                            @foreach (var s in situacoes)
                                            {
                                                <option value="@s" selected="@(os.Situacao == s)">@s</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td class="px-md py-sm">
                                    <div class="flex items-center justify-center gap-xs">
                                        <a asp-action="Ver" asp-route-id="@os.Id" title="Ver e imprimir"
                                           class="w-8 h-8 rounded-lg hover:bg-surface-container-high inline-flex items-center justify-center text-on-surface-variant transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-action="Add" asp-route-id="@os.Id" asp-route-retorno="Index" title="@(ehOrcamento ? "Editar o orçamento" : "Editar a ordem")"
                                           class="w-8 h-8 rounded-lg hover:bg-surface-container-high inline-flex items-center justify-center text-on-surface-variant transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <form asp-action="Excluir" method="post" class="inline"
                                              onsubmit="return confirm('Excluir @(ehOrcamento ? "o orçamento" : "a ordem") @os.Numero?');">
                                            <input type="hidden" name="id" value="@os.Id" />
                                            <button type="submit" title="Excluir"
                                                    class="w-8 h-8 rounded-lg hover:bg-error-container inline-flex items-center justify-center text-outline transition-colors">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="vazioState" class="@(Model.Count == 0 ? "" : "hidden") p-xl text-center">
                <span class="material-symbols-outlined text-[40px] text-outline">request_quote</span>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    @(Model.Count == 0
                        ? (ehOrcamento ? "Nenhum orçamento registrado ainda." : "Nenhuma ordem de serviço registrada ainda.")
                        : "Nada encontrado para esse filtro.")
                </p>
                @if (Model.Count == 0)
                {
                    <a asp-action="Add" class="mt-md inline-flex items-center gap-xs bg-secondary text-white rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        @(ehOrcamento ? "Fazer o primeiro" : "Abrir a primeira")
                    </a>
                }
            </div>
        </section>
    </main>

    <script src="~/js/os-lista.js" asp-append-version="true"></script>
</body>
</html>
