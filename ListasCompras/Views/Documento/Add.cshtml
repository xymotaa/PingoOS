@model ListasCompras.Models.OrdemServico
@{
    Layout = null;
    var editando = Model.Id > 0;
    var ehOrcamento = ViewData["EhOrcamento"] as bool? ?? false;
    // Orçamento não recebe dinheiro nem promete garantia: os campos continuam no HTML
    // (o script de cálculo conta com eles) mas ficam escondidos
    var soOs = ehOrcamento ? "hidden" : "";
    ViewData["Title"] = editando ? "Editar " + Model.Numero
        : Model.OrdemOrigemId.HasValue ? "Retorno em garantia"
        : ehOrcamento ? "Novo orçamento" : "Nova ordem de serviço";
    string Decimal(decimal v) => v.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var erro = TempData["Erro"] as string;
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@nomeLoja — @ViewData["Title"]</title>
    @await Html.PartialAsync("_HeadTailwind")
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <main class="pt-24 px-lg pb-xl max-w-[1440px] mx-auto">

    <form asp-action="Salvar" method="post" id="formOs">
    <input type="hidden" id="clienteId" name="clienteId" value="@(editando ? Model.ClienteId.ToString() : "")" />
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="retorno" value="@(ViewBag.Retorno as string)" />
    @if (Model.OrdemOrigemId.HasValue)
    {
        <input type="hidden" name="ordemOrigemId" value="@Model.OrdemOrigemId" />
    }
        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="mb-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@erro</span>
            </div>
        }


        <div id="toast" class="hidden mb-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
            <span id="toastIcon" class="material-symbols-outlined text-[18px]">check_circle</span>
            <span id="toastMsg"></span>
        </div>

        <!-- Cabeçalho da página -->
        <section class="mb-md flex flex-wrap items-end justify-between gap-md">
            <div>
                                <h1 class="font-headline-lg text-headline-lg text-primary">@ViewData["Title"]</h1>
                @if (Model.OrdemOrigemId.HasValue && Model.Id == 0)
                {
                    <div class="mt-xs bg-warning-container text-on-surface px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs w-fit">
                        <span class="material-symbols-outlined text-[18px]">assignment_return</span>
                        <span>Retorno em garantia da @Model.OrdemOrigem?.Numero — o reparo coberto não se cobra de novo.</span>
                    </div>
                }
                <p class="font-body-md text-body-md text-on-surface-variant">
                    @(ehOrcamento
                        ? "Quanto custaria o serviço. Nada é autorizado aqui — se o cliente aprovar, este orçamento vira uma ordem de serviço."
                        : "Registre os dados do cliente, do aparelho e os itens do serviço.")
                </p>
            </div>
        </section>

        <div class="flex flex-col gap-md">

            <!-- Cliente -->
            <section class="bg-white rounded-xl border border-outline-variant shadow-sm p-lg">
                <div class="flex items-center gap-sm mb-md">
                    <span class="material-symbols-outlined text-[20px] text-secondary">person</span>
                    <h2 class="font-title-lg text-title-lg text-primary">Cliente</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                    <div class="md:col-span-6">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteNome">Nome</label>
                        <div class="relative mt-xs">
                            <input id="clienteNome" type="text" readonly placeholder="Pesquise o cliente cadastrado"
                                   class="w-full bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md cursor-pointer focus:ring-2 focus:ring-secondary/30" value="@(editando ? Model.Cliente.Nome : "")" />
                            <button id="buscarClienteBtn" type="button" title="Pesquisar cliente"
                                    class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-lg hover:bg-surface-container-high flex items-center justify-center text-outline transition-colors">
                                <span class="material-symbols-outlined text-[20px]">search</span>
                            </button>
                            <button id="limparClienteBtn" type="button" title="Trocar de cliente"
                                    class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-lg hover:bg-error-container flex items-center justify-center text-outline transition-colors">
                                <span class="material-symbols-outlined text-[20px]">close</span>
                            </button>
                        </div>
                    </div>
                    <div class="md:col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteTelefone">Telefone</label>
                        <input id="clienteTelefone" type="tel" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Telefone : "")" />
                    </div>
                    <div class="md:col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteDocumento">CPF ou RG</label>
                        <input id="clienteDocumento" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Documento : "")" />
                    </div>

                    <div class="md:col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteCep">CEP</label>
                        <input id="clienteCep" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Cep : "")" />
                    </div>
                    <div class="md:col-span-6">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteEndereco">Endereço (Rua / Av.)</label>
                        <input id="clienteEndereco" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Endereco : "")" />
                    </div>
                    <div class="md:col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteNumero">Número</label>
                        <input id="clienteNumero" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Numero : "")" />
                    </div>
                    <div class="md:col-span-4">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteBairro">Bairro</label>
                        <input id="clienteBairro" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Bairro : "")" />
                    </div>
                    <div class="md:col-span-5">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteCidade">Cidade</label>
                        <input id="clienteCidade" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant" value="@(editando ? Model.Cliente.Cidade : "")" />
                    </div>
                    <div class="md:col-span-3">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="clienteUf">UF</label>
                        <input id="clienteUf" type="text" readonly class="campo-cliente w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md text-on-surface-variant uppercase" value="@(editando ? Model.Cliente.Uf : "")" />
                    </div>
                </div>
            </section>

            <!-- Dados do dispositivo -->
            <section class="bg-white rounded-xl border border-outline-variant shadow-sm p-lg">
                <div class="flex items-center justify-between gap-sm mb-md">
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-[20px] text-secondary">smartphone</span>
                        <h2 class="font-title-lg text-title-lg text-primary">Dados do dispositivo</h2>
                    </div>
                    <button id="adicionarAparelhoBtn" type="button" title="Adicionar outro aparelho a esta OS"
                            class="h-9 px-md rounded-lg bg-secondary text-white flex items-center justify-center gap-xs hover:bg-opacity-90 transition-colors shrink-0">
                        <span class="material-symbols-outlined text-[20px]">add</span>
                        <span class="font-label-md text-label-md font-bold">Adicionar aparelho</span>
                    </button>
                </div>

                <div id="aparelhosBody" class="flex flex-col gap-md"></div>

                <p id="aparelhosLimite" class="hidden mt-sm font-label-sm text-label-sm text-outline">
                    Limite de @ListasCompras.Models.OrdemServico.MaximoAparelhos aparelhos por ordem — é o que cabe nas duas vias impressas.
                </p>
            </section>

            <!-- Diagnóstico -->
            <section class="bg-white rounded-xl border border-outline-variant shadow-sm p-lg">
                <div class="flex items-center gap-sm mb-md">
                    <span class="material-symbols-outlined text-[20px] text-secondary">clinical_notes</span>
                    <h2 class="font-title-lg text-title-lg text-primary">Diagnóstico</h2>
                </div>
                <label class="font-label-md text-label-md text-on-surface-variant" for="diagnostico">Diagnóstico Técnico Preliminar</label>
                <textarea id="diagnostico" name="diagnostico" rows="4" placeholder="Descreva o problema relatado, os testes realizados e o serviço a ser executado..."
                          class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">@Model.Diagnostico</textarea>
            </section>

            <!-- Peças e Serviços -->
            <section class="bg-white rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="p-lg flex flex-wrap items-center justify-between gap-sm">
                    <div class="flex items-center gap-sm">
                        <span class="material-symbols-outlined text-[20px] text-secondary">build</span>
                        <h2 class="font-title-lg text-title-lg text-primary">Peças e Serviços</h2>
                    </div>
                    <button id="adicionarItemBtn" type="button"
                            class="h-9 px-md rounded-lg bg-secondary text-white flex items-center justify-center gap-xs hover:bg-opacity-90 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">add</span>
                        <span class="font-label-md text-label-md font-bold">Adicionar Item</span>
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-surface-container-low border-y border-outline-variant">
                            <tr>
                                <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider">Descrição (Peça / Mão de Obra)</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center w-24">Qtd</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right w-36">Valor Unit. (R$)</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right w-36">Total (R$)</th>
                                <th class="w-10"></th>
                            </tr>
                        </thead>
                        <tbody id="itensBody">
                            @foreach (var item in Model.Itens)
                            {
                                <tr class="border-t border-outline-variant">
                                    <td class="px-md py-sm">
                                        <div class="relative">
                                            <input type="text" name="itemDescricao" value="@item.Descricao" class="item-desc w-full bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" placeholder="Digite ou escolha do catálogo" />
                                            <button type="button" class="escolher-servico absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-lg hover:bg-surface-container-high flex items-center justify-center text-outline transition-colors" title="Escolher do catálogo de serviços">
                                                <span class="material-symbols-outlined text-[20px]">handyman</span>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-md py-sm">
                                        <input type="text" name="itemQuantidade" inputmode="numeric" value="@item.Quantidade" class="item-qtd w-full text-center bg-surface-container-low border-none rounded-lg px-2 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                                    </td>
                                    <td class="px-md py-sm">
                                        <input type="text" inputmode="decimal" value="@Decimal(item.ValorUnitario)" placeholder="0,00" data-mascara="valor" class="item-valor w-full text-right bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                                        <input type="hidden" name="itemValor" class="item-valor-post" value="0" />
                                    </td>
                                    <td class="px-md py-sm text-right">
                                        <span class="item-total font-body-md text-body-md font-semibold text-secondary">R$ 0,00</span>
                                    </td>
                                    <td class="pr-md">
                                        <button type="button" class="remover-item w-8 h-8 rounded-lg hover:bg-error-container inline-flex items-center justify-center text-outline transition-colors" title="Remover item">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="itensVazio" class="hidden px-lg py-lg text-center font-body-md text-body-md text-on-surface-variant">
                    Nenhum item adicionado. Clique em "Adicionar Item" para incluir peças ou mão de obra.
                </div>
                <div class="px-lg py-md border-t border-outline-variant flex items-center justify-end gap-md">
                    <span class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Subtotal</span>
                    <span id="totalGeral" class="font-title-lg text-title-lg font-bold text-primary">R$ 0,00</span>
                </div>
            </section>

            <!-- Pagamento -->
            <section class="bg-white rounded-xl border border-outline-variant shadow-sm p-lg">
                <div class="flex items-center gap-sm mb-md">
                    <span class="material-symbols-outlined text-[20px] text-secondary">payments</span>
                    <h2 class="font-title-lg text-title-lg text-primary">@(ehOrcamento ? "Valores" : "Pagamento")</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-md">

                    @if (ehOrcamento)
                    {
                        <!-- Validade: um preço de peça não vale para sempre -->
                        <div class="md:col-span-4">
                            <label class="font-label-md text-label-md text-on-surface-variant" for="validadeDias">Validade do orçamento</label>
                            <div class="mt-xs flex items-center gap-sm">
                                <input id="validadeDias" name="validadeDias" type="number" min="1" max="180"
                                       value="@(Model.ValidadeDias > 0 ? Model.ValidadeDias : ListasCompras.Models.OrdemServico.ValidadePadraoDias)"
                                       class="w-24 bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                                <span class="font-body-md text-body-md text-on-surface-variant">dias</span>
                            </div>
                            <p class="mt-xs font-label-sm text-label-sm text-outline">
                                Preço de peça muda. Passado o prazo, o orçamento precisa ser refeito.
                            </p>
                        </div>
                    }

                    <!-- Sinal (haver) -->
                    <div class="md:col-span-4 @soOs">
                        <label class="flex items-center gap-xs cursor-pointer">
                            <input id="temSinal" type="checkbox" class="w-4 h-4 accent-secondary" @(Model.Sinal > 0 ? "checked" : "") />
                            <span class="font-label-md text-label-md text-on-surface-variant">Cliente deixou um haver (adiantamento)</span>
                        </label>
                        <input id="sinalVisivel" type="text" inputmode="decimal" placeholder="0,00" data-mascara="valor"
                               value="@(Model.Sinal > 0 ? Decimal(Model.Sinal) : "")"
                               class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30 disabled:opacity-50" />
                        <input type="hidden" name="sinal" id="sinal" value="0" />
                    </div>

                    <!-- Desconto -->
                    <div class="md:col-span-4">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="descontoVisivel">Desconto</label>
                        <div class="mt-xs flex gap-sm">
                            <input id="descontoVisivel" type="text" inputmode="@(Model.DescontoTipo == "valor" ? "decimal" : "numeric")"
                                   placeholder="@(Model.DescontoTipo == "valor" ? "0,00" : "0")"
                                   data-mascara="@(Model.DescontoTipo == "valor" ? "valor" : "")"
                                   value="@(Model.Desconto > 0 ? (Model.DescontoTipo == "valor" ? Decimal(Model.Desconto) : Model.Desconto.ToString("0")) : "")"
                                   class="flex-1 min-w-0 bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                            <select id="descontoTipo" name="descontoTipo"
                                    class="bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                                <option value="percentual" selected="@(Model.DescontoTipo != "valor")">%</option>
                                <option value="valor" selected="@(Model.DescontoTipo == "valor")">R$</option>
                            </select>
                        </div>
                        <input type="hidden" name="desconto" id="desconto" value="0" />
                    </div>

                    <!-- Forma de pagamento -->
                    <div class="md:col-span-4 @soOs">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="formaPagamento">Forma de pagamento</label>
                        <select id="formaPagamento" name="formaPagamento"
                                class="w-full mt-xs bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30">
                            <option value="" selected="@string.IsNullOrEmpty(Model.FormaPagamento)">A combinar</option>
                            <option value="dinheiro" selected="@(Model.FormaPagamento == "dinheiro")">Dinheiro</option>
                            <option value="pix" selected="@(Model.FormaPagamento == "pix")">PIX</option>
                            <option value="debito" selected="@(Model.FormaPagamento == "debito")">Cartão de débito</option>
                            <option value="credito" selected="@(Model.FormaPagamento == "credito")">Cartão de crédito</option>
                        </select>
                    </div>

                    <!-- Parcelamento -->
                    <div class="md:col-span-4 @soOs">
                        <label class="flex items-center gap-xs cursor-pointer">
                            <input id="parcelado" name="parcelado" value="true" type="checkbox" class="w-4 h-4 accent-secondary" @(Model.Parcelado ? "checked" : "") />
                            <span class="font-label-md text-label-md text-on-surface-variant">Parcelado</span>
                        </label>
                        <div class="mt-xs flex items-center gap-sm">
                            <select id="parcelas" name="parcelas"
                                    class="bg-surface-container-low border-none rounded-lg pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30 disabled:opacity-50">
                                @for (var n = 2; n <= 12; n++)
                                {
                                    <option value="@n" selected="@(Model.Parcelas == n)">@n vezes</option>
                                }
                            </select>
                            <span id="valorParcela" class="font-body-md text-body-md text-on-surface-variant"></span>
                        </div>
                    </div>

                    <!-- Garantia -->
                    @{
                        var prazoAtual = Model.PrazoGarantiaDias > 0 ? Model.PrazoGarantiaDias : ListasCompras.Models.OrdemServico.PrazoGarantiaPadrao;
                        var prazosGarantia = new[] { 90, 120, 180, 365 };
                    }
                    <div class="md:col-span-4 @soOs">
                        <label class="font-label-md text-label-md text-on-surface-variant">Garantia do serviço</label>
                        <input type="hidden" id="prazoGarantiaDias" name="prazoGarantiaDias" value="@prazoAtual" />
                        <div class="mt-xs flex flex-wrap gap-xs" role="group" aria-label="Prazo de garantia">
                            @foreach (var dias in prazosGarantia)
                            {
                                <button type="button" data-prazo-garantia-btn data-dias="@dias"
                                        class="prazo-garantia-opcao px-md py-xs rounded-lg border font-label-md text-label-md transition-colors @(prazoAtual == dias ? "border-secondary bg-secondary text-white" : "border-outline-variant text-on-surface-variant hover:bg-surface-container-low")">
                                    @dias dias
                                </button>
                            }
                        </div>
                        <p class="mt-xs font-label-sm text-label-sm text-outline">
                            Mínimo de @ListasCompras.Models.OrdemServico.PrazoGarantiaPadrao dias (CDC, art. 26, II).
                        </p>
                    </div>

                    <!-- Resumo das contas -->
                    <div class="@(ehOrcamento ? "md:col-span-12" : "md:col-span-8")">
                        <div class="bg-surface-container-low rounded-lg p-md flex flex-col gap-xs">
                            <div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
                                <span>Subtotal dos itens</span><span id="resumoSubtotal">R$ 0,00</span>
                            </div>
                            <div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
                                <span>Desconto</span><span id="resumoDesconto">− R$ 0,00</span>
                            </div>
                            <div class="flex justify-between font-body-md text-body-md text-on-surface-variant @soOs">
                                <span>Haver deixado pelo cliente</span><span id="resumoSinal">− R$ 0,00</span>
                            </div>
                            <hr class="border-outline-variant" />
                            <div class="flex justify-between font-title-lg text-title-lg font-bold text-primary">
                                <span>@(ehOrcamento ? "Total do orçamento" : "Falta pagar")</span><span id="resumoSaldo">R$ 0,00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Ações -->
            <div class="flex items-center justify-end gap-sm">
                @if (editando && ViewBag.Retorno as string == "Ver")
                {
                    <a asp-action="Ver" asp-route-id="@Model.Id"
                       class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </a>
                }
                else
                {
                    <a asp-action="Index"
                       class="border border-outline text-on-surface-variant rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </a>
                }
                <button id="salvarOrcamentoBtn" type="submit"
                        class="bg-secondary text-white rounded-lg px-lg py-sm font-label-md text-label-md font-bold hover:bg-opacity-90 transition-colors flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    @(editando ? "Salvar alterações" : ehOrcamento ? "Salvar orçamento" : "Salvar ordem de serviço")
                </button>
            </div>
        </div>
    </form>
    </main>
    <!-- Busca de cliente -->
    <div id="modalCliente" class="no-print hidden fixed inset-0 z-50 bg-black/40 flex items-start justify-center px-md pt-24">
        <div class="bg-white rounded-xl border border-outline-variant shadow-lg w-full max-w-[520px] overflow-hidden">

            <div class="p-md border-b border-outline-variant">
                <div class="flex items-center justify-between gap-sm mb-sm">
                    <h2 class="font-title-lg text-title-lg text-primary">Selecionar cliente</h2>
                    <button id="fecharModalCliente" type="button" title="Fechar"
                            class="w-8 h-8 rounded-lg hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant transition-colors">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="relative">
                    <input id="buscaClienteInput" type="text" placeholder="Nome, telefone ou CPF/RG..." autocomplete="off"
                           class="w-full bg-surface-container-low border-none rounded-full pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                </div>
            </div>

            <div id="resultadosCliente" class="max-h-[320px] overflow-y-auto"></div>

            <div class="p-md border-t border-outline-variant flex items-center justify-between gap-sm">
                <span class="font-label-sm text-label-sm text-outline">Cliente ainda não cadastrado?</span>
                <a asp-controller="Cliente" asp-action="Add" target="_blank"
                   class="font-label-md text-label-md text-secondary font-bold hover:underline flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    Cadastrar
                </a>
            </div>
        </div>
    </div>

    <!-- Escolher do catálogo de serviços -->
    <div id="modalServico" class="hidden fixed inset-0 z-50 bg-black/40 flex items-start justify-center px-md pt-24">
        <div class="bg-white rounded-xl border border-outline-variant shadow-lg w-full max-w-[520px] overflow-hidden">
            <div class="p-md border-b border-outline-variant">
                <div class="flex items-center justify-between gap-sm mb-sm">
                    <h2 class="font-title-lg text-title-lg text-primary">Catálogo de serviços</h2>
                    <button id="fecharModalServico" type="button" title="Fechar"
                            class="w-8 h-8 rounded-lg hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant transition-colors">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="relative">
                    <input id="buscaServicoInput" type="text" placeholder="Nome ou categoria..." autocomplete="off"
                           class="w-full bg-surface-container-low border-none rounded-full pl-md pr-10 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                </div>
            </div>

            <div id="resultadosServico" class="max-h-[320px] overflow-y-auto"></div>

            <div class="p-md border-t border-outline-variant flex items-center justify-between gap-sm">
                <span class="font-label-sm text-label-sm text-outline">O valor pode ser alterado depois de escolher.</span>
                <a asp-controller="Servico" asp-action="Add" target="_blank"
                   class="font-label-md text-label-md text-secondary font-bold hover:underline flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Novo serviço
                </a>
            </div>
        </div>
    </div>

    <script>
        const APARELHOS = @Html.Raw(Json.Serialize(Model.Aparelhos.Select(a => new {
            tipo = a.Tipo ?? "", marca = a.Marca ?? "", modelo = a.Modelo ?? "",
            serie = a.NumeroSerie ?? "", semSerie = a.SemNumeroSerie })));
        const MAX_APARELHOS = @ListasCompras.Models.OrdemServico.MaximoAparelhos;
    </script>
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/orcamento.js" asp-append-version="true"></script>
</body>
</html>
