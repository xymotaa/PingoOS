@model ListasCompras.Models.Venda
@{
    Layout = null;
    ViewData["Title"] = "Comprovante " + Model.Numero;
    var nomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var logo = ViewData["LogoLoja"] as string;
    var lojaCnpj = ViewData["LojaCnpj"] as string;
    var lojaEndereco = ViewData["LojaEndereco"] as string;
    var lojaTelefone = ViewData["LojaTelefone"] as string;
    var lojaEmail = ViewData["LojaEmail"] as string;
    var lojaContato = string.Join(" · ", new[] { lojaTelefone, lojaEmail }.Where(s => !string.IsNullOrWhiteSpace(s)));
    string Moeda(decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    @await Html.PartialAsync("_HeadTailwind")
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }

        /* Dois documentos, só um sai por vez na impressão — mesmo padrão do comprovante de
           entrada da OS (Views/Documento/Ver.cshtml): #reciboPadrao é o normal (papel comum,
           A4), #reciboTermico só existe pra quando a loja tiver de fato uma impressora
           térmica 80mm — sem isso configurada no sistema, o navegador ignora a "named page"
           e imprime em A4 de qualquer forma, então o padrão tem que ficar bom nesse caso. */
        @@page termica { size: 80mm auto; margin: 3mm; }
        @@page { size: A4; margin: 15mm; }
        @@media print {
            html, body { background: #fff !important; }
            .no-print { display: none !important; }
            /* Na impressão sobra só o documento: o cartão que o emoldura na tela some
               (mesmo tratamento de .moldura em Views/Documento/Ver.cshtml) */
            #reciboPadrao, #reciboPadrao > div { padding: 0 !important; margin: 0 auto !important; border: none !important; box-shadow: none !important; }
        }
        body.modo-termico #reciboPadrao { display: none !important; }
        body.modo-termico #reciboTermico { display: block; page: termica; }

        /* Recibo padrão: mesmo idioma visual da impressão de Ordem de Serviço (cabeçalho com
           logo à esquerda / título+meta à direita com régua grossa embaixo, blocos com título
           em fundo cinza, tabela com bordas finas) — mas sem 2ª via, só um recibo até a
           metade da folha A4. Prefixo "rec-" pra não colidir com as classes "os-" da OS,
           mesmo não estando as duas páginas nunca juntas no DOM. */
        #reciboPadrao { color: #000; font-family: 'Hanken Grotesk', Arial, sans-serif; font-size: 11px; line-height: 1.4; }
        #reciboPadrao .rec-topo { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #000; padding-bottom: 6px; margin-bottom: 8px; }
        #reciboPadrao .rec-loja { display: flex; align-items: center; gap: 8px; }
        #reciboPadrao .rec-logo { width: 40px; height: 40px; object-fit: contain; }
        #reciboPadrao .rec-loja-nome { font-size: 15px; font-weight: 700; }
        #reciboPadrao .rec-loja-sub { font-size: 10px; color: #444; }
        #reciboPadrao .rec-doc-meta { text-align: right; font-size: 10px; }
        #reciboPadrao .rec-doc-titulo { font-size: 14px; font-weight: 700; margin-bottom: 2px; }
        #reciboPadrao .rec-bloco { margin-bottom: 8px; }
        #reciboPadrao .rec-bloco-titulo { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; background: #f0f0f0; border: 1px solid #ccc; padding: 2px 8px; margin-bottom: 4px; }
        #reciboPadrao .rec-linhas { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 16px; padding: 0 4px; font-size: 11px; }
        #reciboPadrao .rec-rot { font-weight: 600; }
        #reciboPadrao .rec-tabela { width: 100%; border-collapse: collapse; }
        #reciboPadrao .rec-tabela th, #reciboPadrao .rec-tabela td { border: 1px solid #ccc; padding: 3px 8px; font-size: 11px; }
        #reciboPadrao .rec-tabela th { background: #f0f0f0; }
        #reciboPadrao .rec-rodape { margin-top: 16px; font-size: 9px; text-align: center; color: #666; }

        #reciboTermico {
            display: none;
            font-family: 'Courier New', monospace;
            font-size: 12px; line-height: 1.4; color: #000;
        }
        .term-centro { text-align: center; }
        .term-titulo { font-size: 13px; font-weight: 700; }
        .term-sep { border-top: 1px dashed #000; margin: 6px 0; }
        .term-linha { display: flex; justify-content: space-between; gap: 6px; }
        .term-rot { font-weight: 700; }
        .term-rodape { margin-top: 8px; font-size: 10px; text-align: center; }
    </style>
</head>
<body class="bg-surface">
    <div class="no-print pt-16 max-w-[480px] mx-auto px-lg pb-xl">
        <div class="flex items-center justify-between gap-sm my-md">
            <h1 class="font-title-lg text-title-lg text-primary">Comprovante @Model.Numero</h1>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant mb-md">
            Comprovante não fiscal, sem valor perante o fisco — só o registro da compra para o cliente.
        </p>
        <div class="flex gap-sm">
            <button id="imprimirBtn" type="button"
                    class="h-9 px-md rounded-lg bg-secondary text-white flex items-center gap-xs hover:bg-opacity-90 transition-colors shrink-0">
                <span class="material-symbols-outlined text-[18px]">print</span>
                <span class="font-label-md text-label-md font-bold">Imprimir</span>
            </button>
            <button id="imprimirTermicoBtn" type="button" title="Impressora térmica 58/80mm"
                    class="h-9 px-md rounded-lg border border-outline-variant text-on-surface flex items-center gap-xs hover:bg-surface-container-low transition-colors shrink-0">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                <span class="font-label-md text-label-md font-bold">Impressora térmica</span>
            </button>
        </div>
    </div>

    <!-- Recibo padrão: mesmo estilo visual da impressão de Ordem de Serviço
         (Views/Documento/Ver.cshtml — cabeçalho com régua grossa, blocos com título em fundo
         cinza, tabela com bordas finas), mas sem 2ª via — um documento só, até a metade da
         folha A4. É o que a loja usa até ter impressora térmica. -->
    <div id="reciboPadrao" class="bg-white mx-auto max-w-[560px] p-lg border border-outline-variant rounded-xl mb-xl">
        <div class="rec-topo">
            <div class="rec-loja">
                @if (!string.IsNullOrEmpty(logo))
                {
                    <img src="@logo" alt="@nomeLoja" class="rec-logo" />
                }
                <div>
                    <div class="rec-loja-nome">@nomeLoja</div>
                    @if (!string.IsNullOrWhiteSpace(lojaCnpj)) { <div class="rec-loja-sub">CNPJ: @lojaCnpj</div> }
                    @if (!string.IsNullOrWhiteSpace(lojaEndereco)) { <div class="rec-loja-sub">@lojaEndereco</div> }
                    @if (!string.IsNullOrWhiteSpace(lojaContato)) { <div class="rec-loja-sub">@lojaContato</div> }
                </div>
            </div>
            <div class="rec-doc-meta">
                <div class="rec-doc-titulo">COMPROVANTE NÃO FISCAL</div>
                <div>Nº @Model.Numero</div>
                <div>Data: @Model.Data.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ClienteNome))
        {
            <div class="rec-bloco">
                <div class="rec-bloco-titulo">Cliente</div>
                <div class="rec-linhas">
                    <div><span class="rec-rot">Nome:</span> @Model.ClienteNome</div>
                    @if (!string.IsNullOrWhiteSpace(Model.ClienteTelefone)) { <div><span class="rec-rot">Telefone:</span> @Model.ClienteTelefone</div> }
                </div>
            </div>
        }

        <div class="rec-bloco">
            <div class="rec-bloco-titulo">Itens</div>
            <table class="rec-tabela">
                <thead>
                    <tr>
                        <th style="text-align:left">Descrição</th>
                        <th style="width:48px;text-align:center">Qtd</th>
                        <th style="width:90px;text-align:right">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>@item.Descricao</td>
                            <td style="text-align:center">@item.Quantidade</td>
                            <td style="text-align:right">@Moeda(item.Total)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" style="text-align:right">Subtotal</td>
                        <td style="text-align:right">@Moeda(Model.Subtotal)</td>
                    </tr>
                    @if (Model.Desconto > 0)
                    {
                        <tr>
                            <td colspan="2" style="text-align:right">Desconto</td>
                            <td style="text-align:right">− @Moeda(Model.Desconto)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="2" style="text-align:right;font-weight:700">Total</td>
                        <td style="text-align:right;font-weight:700">@Moeda(Model.Total)</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="rec-bloco">
            <div class="rec-bloco-titulo">Pagamento</div>
            @if (Model.Parcelas.Count <= 1)
            {
                <div class="rec-linhas">
                    <div><span class="rec-rot">Forma:</span> @ListasCompras.Models.FormasPagamento.Rotulo(Model.FormaPagamento)</div>
                    @if (Model.FormaPagamento == ListasCompras.Models.FormasPagamento.Dinheiro && Model.ValorRecebido > 0)
                    {
                        <div><span class="rec-rot">Recebido:</span> @Moeda(Model.ValorRecebido)</div>
                        <div><span class="rec-rot">Troco:</span> @Moeda(Model.Troco)</div>
                    }
                </div>
            }
            else
            {
                <div style="font-size:10px;font-weight:600;margin-bottom:3px">@Model.Parcelas.Count parcelas</div>
                @foreach (var parcela in Model.Parcelas)
                {
                    <div class="rec-linhas" style="grid-template-columns: 2fr 1fr">
                        <div>@parcela.Numero/@Model.Parcelas.Count · @parcela.Data.ToString("dd/MM") · @ListasCompras.Models.FormasPagamento.Rotulo(parcela.FormaPagamento)</div>
                        <div style="text-align:right">@Moeda(parcela.Valor)</div>
                    </div>
                }
            }
        </div>

        <p class="rec-rodape">Este documento não tem valor fiscal.</p>
    </div>

    <!-- Recibo térmico: cupom 80mm monoespaçado — só usado quando a pessoa clica
         "Impressora térmica" (body.modo-termico), pra quem já tem esse hardware. -->
    <div id="reciboTermico">
        <div class="term-centro">
            <div class="term-titulo">@nomeLoja</div>
            @if (!string.IsNullOrWhiteSpace(lojaCnpj)) { <div>CNPJ: @lojaCnpj</div> }
            @if (!string.IsNullOrWhiteSpace(lojaContato)) { <div>@lojaContato</div> }
        </div>
        <div class="term-sep"></div>
        <div class="term-centro term-titulo">COMPROVANTE NÃO FISCAL</div>
        <div class="term-linha"><span class="term-rot">Nº</span><span>@Model.Numero</span></div>
        <div class="term-linha"><span class="term-rot">Data</span><span>@Model.Data.ToString("dd/MM/yyyy HH:mm")</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.ClienteNome))
        {
            <div class="term-linha"><span class="term-rot">Cliente</span><span>@Model.ClienteNome</span></div>
        }
        <div class="term-sep"></div>
        @foreach (var item in Model.Itens)
        {
            <div class="term-linha"><span>@item.Quantidade x @item.Descricao</span><span>@Moeda(item.Total)</span></div>
        }
        <div class="term-sep"></div>
        <div class="term-linha"><span class="term-rot">Subtotal</span><span>@Moeda(Model.Subtotal)</span></div>
        @if (Model.Desconto > 0)
        {
            <div class="term-linha"><span class="term-rot">Desconto</span><span>- @Moeda(Model.Desconto)</span></div>
        }
        <div class="term-linha term-titulo"><span>Total</span><span>@Moeda(Model.Total)</span></div>
        <div class="term-sep"></div>
        @if (Model.Parcelas.Count <= 1)
        {
            <div class="term-linha"><span class="term-rot">Pagamento</span><span>@ListasCompras.Models.FormasPagamento.Rotulo(Model.FormaPagamento)</span></div>
            @if (Model.FormaPagamento == ListasCompras.Models.FormasPagamento.Dinheiro && Model.ValorRecebido > 0)
            {
                <div class="term-linha"><span class="term-rot">Recebido</span><span>@Moeda(Model.ValorRecebido)</span></div>
                <div class="term-linha"><span class="term-rot">Troco</span><span>@Moeda(Model.Troco)</span></div>
            }
        }
        else
        {
            <div class="term-rot">Pagamento em @Model.Parcelas.Count parcelas</div>
            @foreach (var parcela in Model.Parcelas)
            {
                <div class="term-linha">
                    <span>@parcela.Numero/@Model.Parcelas.Count · @parcela.Data.ToString("dd/MM") · @ListasCompras.Models.FormasPagamento.Rotulo(parcela.FormaPagamento)</span>
                    <span>@Moeda(parcela.Valor)</span>
                </div>
            }
        }
        <div class="term-rodape">Este documento não tem valor fiscal.</div>
    </div>

    <script>
        // Padrão e térmico nunca saem juntos: a classe no body escolhe qual dos dois o CSS
        // mostra (mesmo padrão de Views/Documento/Ver.cshtml + wwwroot/js/os-impressao.js).
        document.getElementById("imprimirBtn").addEventListener("click", function () { window.print(); });
        var btnTermico = document.getElementById("imprimirTermicoBtn");
        btnTermico.addEventListener("click", function () {
            document.body.classList.add("modo-termico");
            window.print();
        });
        window.addEventListener("afterprint", function () {
            document.body.classList.remove("modo-termico");
        });
    </script>
</body>
</html>
