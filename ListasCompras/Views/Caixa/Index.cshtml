@model List<ListasCompras.Models.ProdutoEstoque>
@{
    Layout = null;
    ViewData["Title"] = "Caixa";

    var vendaEmEdicaoId = ViewBag.VendaEmEdicaoId is int idEdicao ? idEdicao : 0;

    // Dois produtos são "compatíveis entre si" se atendem pelo menos um mesmo modelo
    // de celular (ex: a película do A15 também serve no A25). Calculado aqui, sobre a
    // lista já carregada em memória (poucos produtos numa loja), para o JS só ter que
    // exibir a etiqueta, sem recalcular relacionamento nenhum.
    var produtosPorModelo = Model
        .SelectMany(p => p.ModelosCompativeis.Select(mc => new { ModeloId = mc.ModeloCelularId, ProdutoId = p.Id }))
        .GroupBy(x => x.ModeloId)
        .ToDictionary(g => g.Key, g => g.Select(x => x.ProdutoId).ToList());

    var compativeisPorProduto = Model.ToDictionary(
        p => p.Id,
        p => p.ModelosCompativeis
            .SelectMany(mc => produtosPorModelo.GetValueOrDefault(mc.ModeloCelularId, new List<int>()))
            .Where(outroId => outroId != p.Id)
            .Distinct()
            .ToList());
}
<!DOCTYPE html>
<html class="light" lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    @await Html.PartialAsync("_HeadTailwind")
    <style>
        @@keyframes row-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
        .row-in { animation: row-in .15s ease-out; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #bfc9c3; border-radius: 10px; }

        /* Painel de fechamento: entra deslizando da direita por cima do PDV, como um
           cupom que "sai da máquina". Fica sempre montado no DOM (facilita o fetch de
           impressão) e só alterna translate-x — nunca display, para a transição rodar. */
        #painelFechamento { transition: transform .22s cubic-bezier(.2,.8,.2,1); }
        #painelFechamento.fechado { transform: translateX(100%); }
        #veuFechamento { transition: opacity .22s ease; }

        /* Passos Produto → Cliente → Pagamento em sequência com seta (estilo Bling): cada
           etapa é um "degrau" — cinza quando ainda não chegou nela, verde quando ativa,
           esmaecida quando já passou. A seta é feita com clip-path, sem imagem. */
        .passo-etapa {
            clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%, 14px 50%);
            background-color: #e5eeff; color: #404944;
        }
        .passo-etapa:first-child { clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%); }
        .passo-etapa + .passo-etapa { margin-left: -14px; }
        .passo-etapa.passo-ativo { background-color: #006c49; color: #ffffff; }
        .passo-etapa.passo-completo { background-color: #cbdbf5; color: #003527; }

        /* Forma de pagamento como cards grandes (inspirado no Bling), não radio simples */
        .card-pagamento { transition: border-color .12s ease, background-color .12s ease; }
        .card-pagamento.selecionado { border-color: #006c49; background-color: rgba(0,108,73,.06); }
    </style>
</head>
<body class="bg-surface">
    @await Html.PartialAsync("_Navbar")

    <!-- Frente de caixa -->
    <div class="pt-16 h-screen flex overflow-hidden">

        <!-- Coluna esquerda: passos Produto → Cliente → Pagamento, como o PDV do Bling -->
        <div class="w-[420px] shrink-0 border-r border-outline-variant bg-white flex flex-col overflow-hidden">

            <div class="shrink-0 flex px-md pt-md">
                <button id="passoProdutoBtn" type="button" data-passo="produto" accesskey="z"
                        class="passo-etapa flex-1 py-sm flex items-center justify-center gap-xs font-label-md text-label-md font-bold uppercase tracking-wide transition-colors">
                    Produto <span class="font-label-sm text-label-sm font-normal opacity-70 normal-case">(Alt+Z)</span>
                </button>
                <button id="passoClienteBtn" type="button" data-passo="cliente" accesskey="c"
                        class="passo-etapa flex-1 py-sm flex items-center justify-center gap-xs font-label-md text-label-md font-bold uppercase tracking-wide transition-colors">
                    Cliente <span class="font-label-sm text-label-sm font-normal opacity-70 normal-case">(Alt+C)</span>
                    <span id="clientePassoMarcador" class="hidden w-1.5 h-1.5 rounded-full bg-warning"></span>
                </button>
                <button id="passoPagamentoBtn" type="button" data-passo="pagamento" accesskey="b"
                        class="passo-etapa flex-1 py-sm flex items-center justify-center gap-xs font-label-md text-label-md font-bold uppercase tracking-wide transition-colors">
                    Pagamento <span class="font-label-sm text-label-sm font-normal opacity-70 normal-case">(Alt+B)</span>
                </button>
            </div>

            @if (vendaEmEdicaoId > 0)
            {
                <div class="shrink-0 mt-sm mx-md bg-warning-container text-on-surface px-md py-sm rounded-lg font-label-md text-label-md flex items-center justify-between gap-xs">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                        Venda @ViewBag.VendaEmEdicaoNumero
                    </span>
                    <a asp-action="Vendas" class="font-label-md text-label-md underline hover:no-underline">Cancelar</a>
                </div>
            }

            @if (TempData["Erro"] != null)
            {
                <div id="avisoErro" class="shrink-0 mt-sm mx-md bg-error-container text-error px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                    <span>@TempData["Erro"]</span>
                </div>
            }

            <div id="toast" class="hidden shrink-0 mt-sm mx-md bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs">
                <span id="toastIcon" class="material-symbols-outlined text-[18px]">check_circle</span>
                <span id="toastMsg">Venda finalizada.</span>
            </div>

            <!-- Passo Produto: busca + resultados; ao escolher um, abre a área de edição
                 (qtd/desconto/valor/subtotal/comentário) antes de entrar no carrinho. -->
            <div id="passoProduto" class="flex-1 flex flex-col overflow-hidden">
                <form id="buscaForm" class="shrink-0 p-md" autocomplete="off">
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[22px]">barcode_scanner</span>
                        <input id="buscaInput" autocomplete="off"
                               class="w-full bg-surface-container-low border-none rounded-lg pl-11 pr-4 py-3 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30"
                               placeholder="Pesquise por código, descrição (F2)" type="text" />
                    </div>
                </form>

                <div id="listaProduto" class="flex-1 flex flex-col overflow-hidden">
                    <div id="resultadosProduto" class="flex-1 overflow-y-auto custom-scrollbar px-sm pb-sm"></div>
                    <div id="resultadosProdutoVazio" class="flex-1 flex flex-col items-center justify-center gap-xs px-lg text-center">
                        <span class="material-symbols-outlined text-[32px] text-outline-variant">search</span>
                        <p class="font-body-md text-body-md text-on-surface-variant">Digite para buscar um produto pelo nome ou código.</p>
                    </div>
                </div>

                <!-- Edição do produto escolhido: nasce escondida, aparece ao clicar num resultado -->
                <div id="edicaoProduto" class="hidden flex-1 flex flex-col overflow-y-auto custom-scrollbar p-md gap-md">
                    <div class="flex items-start gap-md">
                        <div id="edicaoProdutoImg" class="w-20 h-20 shrink-0 rounded-lg bg-surface-container-low flex items-center justify-center overflow-hidden"></div>
                        <div class="min-w-0">
                            <p id="edicaoProdutoNome" class="font-title-lg text-title-lg text-on-surface font-bold leading-tight"></p>
                            <p id="edicaoProdutoCodigo" class="font-label-sm text-label-sm text-outline mt-xs"></p>
                            <p id="edicaoProdutoPreco" class="font-headline-md text-headline-md text-primary mt-xs"></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-sm">
                        <div>
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="edicaoQtd">Quantidade</label>
                            <div class="flex items-center gap-xs mt-xs">
                                <button id="edicaoQtdDec" type="button" class="w-9 h-9 shrink-0 rounded-lg border border-outline-variant hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant font-bold">−</button>
                                <input id="edicaoQtd" type="number" min="1" step="1" value="1"
                                       class="w-full text-center bg-surface-container-low border-none rounded-lg py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                                <button id="edicaoQtdInc" type="button" class="w-9 h-9 shrink-0 rounded-lg border border-outline-variant hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant font-bold">+</button>
                            </div>
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="edicaoDesconto">Desconto (%)</label>
                            <input id="edicaoDesconto" type="number" min="0" max="100" step="0.01" placeholder="0,00"
                                   class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="edicaoValorUnitario">Valor unitário</label>
                            <input id="edicaoValorUnitario" type="number" min="0" step="0.01"
                                   class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                        </div>
                        <div>
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Subtotal</label>
                            <div id="edicaoSubtotal" class="w-full mt-xs bg-surface-container-low rounded-lg px-md py-2 font-body-md text-body-md font-bold text-primary">R$ 0,00</div>
                        </div>
                    </div>

                    <div>
                        <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="edicaoComentario">Comentário</label>
                        <textarea id="edicaoComentario" rows="2" placeholder="Ex: cor azul, embrulho para presente..."
                                  class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30 resize-none"></textarea>
                    </div>

                    <div class="flex gap-sm mt-auto pt-sm">
                        <button id="edicaoCancelarBtn" type="button"
                                class="flex-1 py-sm rounded-lg font-label-md text-label-md border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors">
                            Cancelar
                        </button>
                        <button id="edicaoInserirBtn" type="button"
                                class="flex-1 py-sm rounded-lg font-label-md text-label-md font-bold bg-secondary text-white hover:bg-opacity-90 transition-colors flex items-center justify-center gap-xs">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            Inserir
                        </button>
                    </div>
                </div>
            </div>

            <!-- Passo Cliente: texto livre, sem puxar do cadastro — cards de identificação
                 opcionais, a vendedora só anota o que a pessoa falar. -->
            <div id="passoCliente" class="hidden flex-1 flex flex-col overflow-y-auto custom-scrollbar p-md gap-md">
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Identificar o cliente é opcional — preencha só o que for útil.
                </p>
                <div>
                    <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="clienteNomeInput">Nome</label>
                    <input id="clienteNomeInput" type="text" placeholder="Nome do cliente"
                           class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                </div>
                <div>
                    <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="clienteTelefoneInput">Telefone</label>
                    <input id="clienteTelefoneInput" type="tel" placeholder="(00) 00000-0000"
                           class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                </div>
                <div>
                    <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="clienteDocumentoInput">CPF ou RG</label>
                    <input id="clienteDocumentoInput" type="text" placeholder="Documento"
                           class="w-full mt-xs bg-surface-container-low border-none rounded-lg px-md py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                </div>
            </div>

            <!-- Passo Pagamento: forma de pagamento em cards + parcelas editáveis
                 independentes (data/valor/forma/observação cada uma), no estilo Bling. -->
            <div id="passoPagamento" class="hidden flex-1 flex flex-col overflow-y-auto custom-scrollbar p-md gap-md">
                <div>
                    <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider mb-sm">Forma de pagamento da 1ª parcela</p>
                    <div class="grid grid-cols-3 gap-sm" id="formasPagamento">
                        <label class="card-pagamento border border-outline-variant rounded-lg px-sm py-sm cursor-pointer flex flex-col items-center gap-xs" data-metodo="dinheiro">
                            <input type="radio" name="metodo" value="dinheiro" class="hidden" checked />
                            <span class="material-symbols-outlined text-[22px] text-on-surface-variant">payments</span>
                            <span class="font-label-sm text-label-sm text-on-surface text-center leading-tight">Dinheiro</span>
                        </label>
                        <label class="card-pagamento border border-outline-variant rounded-lg px-sm py-sm cursor-pointer flex flex-col items-center gap-xs" data-metodo="cartao">
                            <input type="radio" name="metodo" value="cartao" class="hidden" />
                            <span class="material-symbols-outlined text-[22px] text-on-surface-variant">credit_card</span>
                            <span class="font-label-sm text-label-sm text-on-surface text-center leading-tight">Cartão</span>
                        </label>
                        <label class="card-pagamento border border-outline-variant rounded-lg px-sm py-sm cursor-pointer flex flex-col items-center gap-xs" data-metodo="pix">
                            <input type="radio" name="metodo" value="pix" class="hidden" />
                            <span class="material-symbols-outlined text-[22px] text-on-surface-variant">qr_code_2</span>
                            <span class="font-label-sm text-label-sm text-on-surface text-center leading-tight">PIX</span>
                        </label>
                    </div>
                </div>

                <div id="painelDinheiro" class="grid grid-cols-2 gap-sm">
                    <div>
                        <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="valorRecebido">Total recebido em dinheiro</label>
                        <div class="relative mt-xs">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 font-body-md text-body-md text-outline">R$</span>
                            <input id="valorRecebido" type="number" min="0" step="0.01" placeholder="0,00"
                                   class="w-full bg-surface-container-low border-none rounded-lg pl-10 pr-3 py-2 font-body-md text-body-md focus:ring-2 focus:ring-secondary/30" />
                        </div>
                    </div>
                    <div>
                        <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Troco em dinheiro</label>
                        <div id="trocoValor" class="w-full mt-xs bg-surface-container-low rounded-lg px-md py-2 font-body-md text-body-md font-bold text-primary">R$ 0,00</div>
                    </div>
                </div>

                <div class="border-t border-outline-variant pt-md">
                    <div class="flex items-center justify-between mb-sm">
                        <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Parcelas</p>
                        <span id="parcelasSomaAviso" class="hidden font-label-sm text-label-sm text-error font-bold"></span>
                    </div>
                    <div id="parcelasBody" class="flex flex-col gap-sm"></div>
                    <button id="adicionarParcelaBtn" type="button"
                            class="mt-sm font-label-md text-label-md text-secondary font-bold hover:underline flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        Adicionar outra parcela
                    </button>
                </div>
            </div>
        </div>

        <!-- Coluna direita: itens da venda ocupando a largura toda + rodapé de total/ações -->
        <div class="flex-1 flex flex-col overflow-hidden min-w-0">

            <div class="flex-1 overflow-y-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 bg-white border-b border-outline-variant z-10">
                        <tr>
                            <th class="px-lg py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider" colspan="2">Produto</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center">Qtd.</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right">Preço</th>
                            <th class="px-md py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-right">Sub Total</th>
                            <th class="px-lg py-sm font-label-sm text-label-sm text-outline uppercase tracking-wider text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="itensBody"></tbody>
                </table>
                <div id="vazioState" class="p-xl text-center flex flex-col items-center gap-xs">
                    <span class="material-symbols-outlined text-[40px] text-outline-variant">point_of_sale</span>
                    <p class="font-body-md text-body-md text-on-surface-variant">Nenhum item na venda. Busque um produto na coluna ao lado para começar.</p>
                </div>
            </div>

            <!-- Rodapé: excluir/finalizar + total, sempre visível -->
            <div class="shrink-0 border-t border-outline-variant bg-white px-lg py-md flex items-center justify-between gap-lg">
                <div class="flex items-center gap-sm">
                    @if (vendaEmEdicaoId > 0)
                    {
                        <a asp-action="Vendas" title="Cancelar edição (Alt+Q)" accesskey="q"
                           class="px-lg py-sm rounded-lg font-label-md text-label-md border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors">
                            Excluir venda <span class="font-label-sm text-label-sm opacity-70">(Alt+Q)</span>
                        </a>
                    }
                    else
                    {
                        <button id="excluirVendaBtn" type="button" title="Limpar venda (Alt+Q)" accesskey="q"
                                class="px-lg py-sm rounded-lg font-label-md text-label-md border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors">
                            Excluir venda <span class="font-label-sm text-label-sm opacity-70">(Alt+Q)</span>
                        </button>
                    }

                    <form id="formVenda" asp-action="@(vendaEmEdicaoId > 0 ? "SalvarEdicao" : "Finalizar")" method="post">
                        @if (vendaEmEdicaoId > 0)
                        {
                            <input type="hidden" name="vendaId" value="@vendaEmEdicaoId" />
                        }
                        <input type="hidden" name="valorRecebido" id="valorRecebidoPost" value="0" />
                        <input type="hidden" name="clienteNome" id="clienteNomePost" value="" />
                        <input type="hidden" name="clienteTelefone" id="clienteTelefonePost" value="" />
                        <input type="hidden" name="clienteDocumento" id="clienteDocumentoPost" value="" />
                        <div id="itensPost"></div>
                        <div id="parcelasPost"></div>
                        <button id="finalizarBtn" type="submit" disabled accesskey="s" title="Finalizar venda (Alt+S)"
                                class="px-xl py-sm rounded-lg font-label-md text-label-md font-bold flex items-center justify-center gap-xs transition-all bg-outline-variant text-outline cursor-not-allowed">
                            @(vendaEmEdicaoId > 0 ? "Salvar edição" : "Finalizar venda")
                            <span class="font-label-sm text-label-sm opacity-70">(Alt+S)</span>
                            <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        </button>
                    </form>
                </div>

                <div class="flex items-baseline gap-sm">
                    <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Total</span>
                    <span id="totalValor" class="font-headline-lg text-headline-lg text-primary">R$ 0,00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Painel de fechamento: some por trás de um véu, desliza da direita quando a venda
         é gravada. Mostra o que acabou de ser vendido e as ações possíveis sobre ela
         (impressão do comprovante não fiscal, NFC-e futura) antes de encerrar o atendimento. -->
    <div id="veuFechamento" class="hidden fixed inset-0 z-[70] bg-[#0b1c30]/40 opacity-0"></div>
    <aside id="painelFechamento" class="fechado fixed top-0 right-0 z-[80] h-screen w-full max-w-[400px] bg-white shadow-lg flex flex-col">
        <div class="shrink-0 px-lg py-md border-b border-outline-variant flex items-center justify-between gap-sm bg-secondary-container">
            <div class="flex items-center gap-sm text-on-secondary-container">
                <span class="material-symbols-outlined text-[22px]">check_circle</span>
                <div>
                    <p class="font-title-lg text-title-lg font-bold">Venda concluída</p>
                    <p id="painelVendaNumero" class="font-label-sm text-label-sm">—</p>
                </div>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto custom-scrollbar px-lg py-md">
            <h3 class="font-label-sm text-label-sm text-outline uppercase tracking-wider mb-sm">Itens vendidos</h3>
            <div id="painelItens" class="flex flex-col gap-xs mb-md font-body-md text-body-md text-on-surface"></div>

            <div class="border-t border-outline-variant pt-sm flex justify-between items-center">
                <span class="font-label-md text-label-md text-outline uppercase tracking-wider">Total</span>
                <span id="painelTotal" class="font-headline-md text-headline-md text-primary">R$ 0,00</span>
            </div>

            <div id="painelAviso" class="hidden mt-md bg-warning-container text-on-surface px-md py-sm rounded-lg font-label-md text-label-md flex items-center gap-xs"></div>
        </div>

        <div class="shrink-0 p-lg border-t border-outline-variant flex flex-col gap-sm">
            <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Documento da venda</p>
            <button id="painelNfceBtn" type="button" disabled title="Emissão de NFC-e ainda não disponível"
                    class="w-full py-sm rounded-lg font-label-md text-label-md flex items-center justify-center gap-xs bg-surface-container-low text-outline cursor-not-allowed">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                Gerar NFC-e
                <span class="ml-auto font-label-sm text-label-sm bg-outline-variant text-on-surface-variant px-xs rounded">em breve</span>
            </button>
            <a id="painelReciboBtn" href="#" target="_blank" rel="noopener"
               class="w-full py-sm rounded-lg font-label-md text-label-md flex items-center justify-center gap-xs border border-outline-variant text-on-surface hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-[18px]">print</span>
                Imprimir comprovante não fiscal
            </a>
            <button id="fecharVendaBtn" type="button"
                    class="w-full py-md rounded-lg font-title-lg text-title-lg flex items-center justify-center gap-xs bg-primary text-white hover:bg-opacity-90 transition-colors mt-xs">
                Fechar Venda
                <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </div>
    </aside>

    <div id="modalVariacao" class="hidden fixed inset-0 z-[60] bg-[#0b1c30]/40 flex items-center justify-center p-md">
        <div class="bg-white rounded-xl shadow-lg w-full max-w-[420px] p-lg">
            <div class="flex justify-between items-center mb-md">
                <h2 id="modalVariacaoTitulo" class="font-title-lg text-title-lg text-primary">Escolha a variação</h2>
                <button id="fecharModalVariacaoBtn" type="button" class="w-8 h-8 rounded-lg hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <div id="modalVariacaoLista" class="flex flex-col gap-xs max-h-[360px] overflow-y-auto"></div>
        </div>
    </div>

    <script>
        const PRODUTOS = @Html.Raw(Json.Serialize(Model.Select(p => new {
            p.Id, p.Codigo, p.Nome, PrecoUnitario = p.PrecoVenda,
            SaldoAtual = p.Formato == "variacao" ? p.Variacoes.Sum(v => v.SaldoAtual) : p.SaldoAtual,
            ImagemUrl = p.Imagem != null ? Url.Content("~/uploads/produtos/" + p.Imagem) : null,
            Variacoes = p.Formato == "variacao"
                ? p.Variacoes.Select(v => new { v.Id, v.Codigo, Descricao = v.DescricaoVariacao, PrecoUnitario = v.PrecoVenda, v.SaldoAtual }).ToList()
                : null,
            CompativeisComIds = compativeisPorProduto.GetValueOrDefault(p.Id, new List<int>())
        })));
        // Presente só na tela de edição de venda (ver CaixaController.EditarVenda) — o
        // carrinho nasce com esses itens em vez de vazio.
        const ITENS_EM_EDICAO = @Html.Raw(Json.Serialize(ViewBag.ItensEmEdicao ?? new List<object>()));
        const CLIENTE_EM_EDICAO = @Html.Raw(Json.Serialize(ViewBag.ClienteEmEdicao));
        const PARCELAS_EM_EDICAO = @Html.Raw(Json.Serialize(ViewBag.ParcelasEmEdicao ?? new List<object>()));
        const VALOR_RECEBIDO_EM_EDICAO = @Html.Raw(Json.Serialize(ViewBag.ValorRecebidoEmEdicao ?? 0m));
        const VENDA_EM_EDICAO_ID = @vendaEmEdicaoId;
    </script>
    <script src="~/js/ui-transicoes.js" asp-append-version="true"></script>
    <script src="~/js/caixa.js" asp-append-version="true"></script>
</body>
</html>
