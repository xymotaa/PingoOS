@using ListasCompras.Models
@{
    var navNomeLoja = ViewData["NomeLoja"] as string ?? "Minha Loja";
    var navLogo = ViewData["LogoLoja"] as string;
    var navInicial = string.IsNullOrWhiteSpace(navNomeLoja) ? "L" : navNomeLoja.Trim()[0].ToString().ToUpper();

    var navUsuario = User.Identity?.Name;
    var navAdmin = User.IsInRole(Papeis.Admin);
    var navPapel = Papeis.Rotulo(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "");
}
<!-- Barra superior -->
<header class="no-print fixed top-0 w-full z-50 bg-surface border-b border-outline-variant shadow-sm flex justify-between items-center h-16 px-lg">
    <div class="flex items-center gap-md md:gap-xl">
        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-sm shrink-0">
            <span class="font-headline-md text-headline-md font-bold text-primary">Pingo OS</span>
        </a>
    </div>
    <div class="flex items-center gap-md">
        <div class="relative">
            <button id="userMenuBtn" type="button" class="flex items-center gap-sm rounded-full hover:bg-surface-container-high transition-colors pl-sm pr-xs py-xs">
                <div class="text-right hidden sm:block">
                    <p class="font-label-md text-label-md font-semibold text-on-surface">@(navUsuario ?? navNomeLoja)</p>
                    <p class="font-label-sm text-label-sm text-outline">@navPapel</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold overflow-hidden border-2 border-primary-fixed">
                    @if (!string.IsNullOrEmpty(navLogo))
                    {
                        <img src="@navLogo" alt="Logo" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span>@navInicial</span>
                    }
                </div>
                <span class="material-symbols-outlined text-[20px] text-on-surface-variant hidden sm:inline">expand_more</span>
            </button>
            <div id="userMenu" class="hidden absolute right-0 top-full mt-sm w-64 bg-white rounded-xl border border-outline-variant shadow-lg overflow-hidden z-50 opacity-0 scale-95 -translate-y-1 transition-all duration-150 ease-out">
                <div class="flex items-center gap-sm px-md py-md bg-surface-container-low">
                    <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold overflow-hidden shrink-0">
                        @if (!string.IsNullOrEmpty(navLogo))
                        {
                            <img src="@navLogo" alt="Logo" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span>@navInicial</span>
                        }
                    </div>
                    <div class="min-w-0">
                        <p class="font-label-md text-label-md font-semibold text-on-surface truncate">@(navUsuario ?? navNomeLoja)</p>
                        <p class="font-label-sm text-label-sm text-outline">@navPapel</p>
                    </div>
                </div>
                <div class="p-xs">
                    @if (navAdmin)
                    {
                        <a asp-controller="Configuracao" asp-action="Index" class="flex items-center gap-xs px-sm py-xs rounded-lg hover:bg-surface-container-low transition-colors text-on-surface">
                            <span class="material-symbols-outlined text-[18px] text-on-surface-variant">storefront</span>
                            <span class="font-label-md text-label-md">Perfil da loja</span>
                        </a>
                        <a asp-controller="Conta" asp-action="Usuarios" class="flex items-center gap-xs px-sm py-xs rounded-lg hover:bg-surface-container-low transition-colors text-on-surface">
                            <span class="material-symbols-outlined text-[18px] text-on-surface-variant">group</span>
                            <span class="font-label-md text-label-md">Usuários</span>
                        </a>
                    }
                    <a asp-controller="Conta" asp-action="Sair" class="flex items-center gap-xs px-sm py-xs rounded-lg hover:bg-error-container hover:text-error transition-colors text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">logout</span>
                        <span class="font-label-md text-label-md">Sair</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
<script>
    // Dropdown do usuário: fade + leve escala/deslize em vez do hidden/visible abrupto de
    // antes. Mesmo padrão usado nos modais do sistema (ver wwwroot/js/ui-transicoes.js).
    (function () {
        const btn = document.getElementById("userMenuBtn");
        const menu = document.getElementById("userMenu");
        if (!btn || !menu) return;

        function abrir() {
            menu.classList.remove("hidden");
            requestAnimationFrame(function () {
                menu.classList.remove("opacity-0", "scale-95", "-translate-y-1");
            });
        }
        function fechar() {
            if (menu.classList.contains("hidden")) return;
            menu.classList.add("opacity-0", "scale-95", "-translate-y-1");
            setTimeout(function () { menu.classList.add("hidden"); }, 150);
        }

        btn.addEventListener("click", function (e) {
            e.stopPropagation();
            menu.classList.contains("hidden") ? abrir() : fechar();
        });
        document.addEventListener("click", function (e) {
            if (!menu.contains(e.target) && !btn.contains(e.target)) fechar();
        });
    })();
</script>
